# Builds the Rust library with cargokit and bundles it (Freya TDE).
# The Flutter tooling requires CMake 3.14 or later; do not raise the version.
cmake_minimum_required(VERSION 3.14)

set(PROJECT_NAME "{{ project.lib }}")
project(${PROJECT_NAME} LANGUAGES CXX)

include("../cargokit/cmake/cargokit.cmake")
# Windows resolves ".." on the symlinked path
# (windows/flutter/ephemeral/.plugin_symlinks/<plugin>/windows): six levels up
# is the Flutter app, one more the project folder with the Cargo.toml.
apply_cargokit(${PROJECT_NAME} ../../../../../../.. {{ project.lib }} "")

set({{ project.lib }}_bundled_libraries
  "${${PROJECT_NAME}_cargokit_lib}"
  PARENT_SCOPE
)
