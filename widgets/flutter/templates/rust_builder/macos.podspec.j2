#
# Builds the Rust library ../../.. with cargokit and links it into this
# framework (Freya TDE). flutter_rust_bridge opens {{ project.lib }}.framework.
#
Pod::Spec.new do |s|
  s.name             = '{{ project.lib }}'
  s.version          = '0.0.1'
  s.summary          = 'Rust library of {{ project.name }}'
  s.description      = 'Builds the Rust library with cargokit.'
  s.homepage         = 'https://freya-tde.dev'
  s.license          = { :type => 'Custom', :text => 'See the project.' }
  s.author           = { '{{ project.name }}' => '' }

  s.source           = { :path => '.' }
  s.source_files     = 'Classes/**/*'
  s.dependency 'FlutterMacOS'

  s.platform = :osx, '10.11'
  s.swift_version = '5.0'

  s.script_phase = {
    :name => 'Build Rust library',
    # Relative path to the folder with the Cargo.toml, then the library name.
    :script => 'sh "$PODS_TARGET_SRCROOT/../cargokit/build_pod.sh" ../../.. {{ project.lib }}',
    :execution_position => :before_compile,
    :input_files => ['${BUILT_PRODUCTS_DIR}/cargokit_phony'],
    :output_files => ["${BUILT_PRODUCTS_DIR}/lib{{ project.lib }}.a"],
  }
  s.pod_target_xcconfig = {
    'DEFINES_MODULE' => 'YES',
    'OTHER_LDFLAGS' => '-force_load ${BUILT_PRODUCTS_DIR}/lib{{ project.lib }}.a',
  }
end
