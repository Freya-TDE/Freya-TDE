# Builds the Rust library ../../.. with cargokit and bundles it (Freya TDE).
# The Flutter tooling requires CMake 3.10 or later; do not raise the version.
cmake_minimum_required(VERSION 3.10)
cmake_policy(SET CMP0079 NEW)

set(PROJECT_NAME "{{ project.lib }}")
project(${PROJECT_NAME} LANGUAGES CXX)

include("../cargokit/cmake/cargokit.cmake")
# The plugin folder is a symlink; ".." is resolved on the real path, so this
# is the project folder with the Cargo.toml.
apply_cargokit(${PROJECT_NAME} ../../.. {{ project.lib }} "")

set({{ project.lib }}_bundled_libraries
  "${${PROJECT_NAME}_cargokit_lib}"
  PARENT_SCOPE
)
