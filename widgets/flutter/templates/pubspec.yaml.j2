# Flutter side of {{ project.name }} (Freya TDE). Your file: created once.
# The Rust library's plugin (rust_builder/) carries the library name, so the
# app is named <library>_app.
name: {{ project.lib }}_app
description: Flutter UI of {{ project.name }}; the logic is the Rust library in ../
publish_to: none
version: 0.1.0

environment:
  sdk: ^3.9.0

dependencies:
  flutter:
    sdk: flutter
  # The same version as flutter_rust_bridge in ../Cargo.toml.
  flutter_rust_bridge: 2.13.0
  # Builds the Rust library on `flutter build` and bundles it into the program (cargokit).
  {{ project.lib }}:
    path: rust_builder
  # Window title, size, position and start state from the designer.
  window_manager: ^0.5.2

flutter:
  uses-material-design: true
