{#- Flutter: the widgets of a form (flutter/lib/freya/<form>.g.dart). The state
    comes from the Rust side (`freyaSnapshot`), input goes back with
    `freyaEvent`; every container gets a method `_w_<name>` for its children. -#}
{%- set view = form.struct ~ "View" %}
{%- set containers = ["core/Form", "core/Container", "backend:flutter/Card", "backend:flutter/Tabs"] %}
{#- Wie die Theme-Tabelle des Designers: Rand 12, Abstand 8. -#}
{%- set default_layout = {"kind": "vertical", "spacing": 8, "padding": {"left": 12, "top": 12, "right": 12, "bottom": 12}} %}
{#- Widgets that need a width from their parent in a row. -#}
{%- set expanding = ["core/Edit", "backend:flutter/TextEdit", "backend:flutter/ComboBox", "backend:flutter/ListBox", "backend:flutter/Slider", "backend:flutter/ProgressBar", "backend:flutter/DataGrid", "core/Container", "backend:flutter/Card", "backend:flutter/Tabs"] %}
{%- set edits = widgets | selectattr("field") | selectattr("type", "in", ["core/Edit", "backend:flutter/TextEdit"]) | list %}
{%- set menus = components | selectattr("type", "eq", "backend:flutter/MainMenu") | selectattr("field") | list %}
{%- set fits = {"Cover": "BoxFit.cover", "Stretch": "BoxFit.fill", "Contain": "BoxFit.contain", "Center": "BoxFit.none"} %}

{%- macro color(v) -%}
{%- if v.a > 0 %}Color.fromARGB({{ v.a }}, {{ v.r }}, {{ v.g }}, {{ v.b }}){% else %}null{% endif -%}
{%- endmacro %}

{#- The widget `c` itself (`c` in Dart: its state). -#}
{%- macro control(c) -%}
{%- set t = c.type -%}
{%- set n = c.name | dart_str -%}
{%- if t == "core/Label" -%}
Text(c.text)
{%- elif t == "core/Button" -%}
ElevatedButton(
  {%- if c.props.background.a > 0 or c.props.foreground.a > 0 %}
  style: ElevatedButton.styleFrom(backgroundColor: {{ color(c.props.background) }}, foregroundColor: {{ color(c.props.foreground) }}),
  {%- endif %}
  onPressed: c.enabled ? () => _send({{ n }}, 'on_click') : null,
  child: Text(c.caption),
)
{%- elif t == "core/Edit" -%}
TextField(
  controller: _edit({{ n }}),
  enabled: c.enabled,
  readOnly: {{ "true" if c.props.read_only else "false" }},
  obscureText: {{ "true" if c.props.password else "false" }},
  {%- if c.props.max_length > 0 %}
  maxLength: {{ c.props.max_length }},
  {%- endif %}
  decoration: InputDecoration(
    isDense: true,
    border: const OutlineInputBorder(),
    {%- if c.props.placeholder %}
    hintText: {{ c.props.placeholder | dart_str }},
    {%- endif %}
  ),
  onChanged: (text) => _send({{ n }}, 'on_change', freyaInput(text: text)),
  onSubmitted: (_) => _send({{ n }}, 'on_submit'),
)
{%- elif t == "backend:flutter/TextEdit" -%}
TextField(
  controller: _edit({{ n }}),
  enabled: c.enabled,
  readOnly: {{ "true" if c.props.read_only else "false" }},
  minLines: {{ c.props.rows }},
  maxLines: {{ c.props.rows }},
  {%- if c.props.monospace %}
  style: const TextStyle(fontFamily: 'monospace'),
  {%- endif %}
  decoration: const InputDecoration(isDense: true, border: OutlineInputBorder()),
  onChanged: (text) => _send({{ n }}, 'on_change', freyaInput(text: text)),
)
{%- elif t == "core/CheckBox" -%}
InkWell(
  onTap: c.enabled ? () => _send({{ n }}, 'on_toggle', freyaInput(checked: !c.checked)) : null,
  child: Row(mainAxisSize: MainAxisSize.min, children: [
    Checkbox(
      value: c.checked,
      onChanged: c.enabled ? (v) => _send({{ n }}, 'on_toggle', freyaInput(checked: v ?? false)) : null,
    ),
    Flexible(child: Text(c.caption)),
  ]),
)
{%- elif t == "backend:flutter/RadioButton" -%}
RadioGroup<bool>(
  groupValue: c.checked,
  onChanged: (_) => _send({{ n }}, 'on_toggle', freyaInput(checked: true)),
  child: InkWell(
    onTap: c.enabled ? () => _send({{ n }}, 'on_toggle', freyaInput(checked: true)) : null,
    child: Row(mainAxisSize: MainAxisSize.min, children: [
      Radio<bool>(value: true, enabled: c.enabled),
      Flexible(child: Text(c.caption)),
    ]),
  ),
)
{%- elif t == "backend:flutter/Switch" -%}
Switch(
  value: c.checked,
  onChanged: c.enabled ? (v) => _send({{ n }}, 'on_toggle', freyaInput(checked: v)) : null,
)
{%- elif t == "backend:flutter/Slider" -%}
Slider(
  value: c.number.clamp({{ c.props.minimum }}, {{ c.props.maximum }}).toDouble(),
  min: {{ c.props.minimum }},
  max: {{ c.props.maximum }},
  {%- if c.props.divisions > 0 %}
  divisions: {{ c.props.divisions }},
  {%- endif %}
  onChanged: c.enabled ? (v) => _send({{ n }}, 'on_change', freyaInput(number: v)) : null,
)
{%- elif t == "backend:flutter/ProgressBar" -%}
LinearProgressIndicator(value: c.number.clamp(0.0, 1.0).toDouble())
{%- elif t == "backend:flutter/ComboBox" -%}
DropdownButton<int>(
  isExpanded: true,
  value: c.index >= 0 && c.index < c.items.length ? c.index : null,
  items: [
    for (var i = 0; i < c.items.length; i++) DropdownMenuItem(value: i, child: Text(c.items[i])),
  ],
  onChanged: c.enabled ? (v) => _send({{ n }}, 'on_select', freyaInput(index: v ?? -1)) : null,
)
{%- elif t == "core/ImageBox" -%}
{%- set p = c.placement if c.placement and c.placement.kind == "layout" else none %}
GestureDetector(
  onTap: c.enabled ? () => _send({{ n }}, 'on_click') : null,
  child: SizedBox(
    width: {{ p.width if p and p.width > 0 else 96 }},
    height: {{ p.height if p and p.height > 0 else 96 }},
    child: c.text.isEmpty ? const SizedBox() : Image.file(File(c.text), fit: {{ fits[c.props.fit] }}),
  ),
)
{%- elif t == "core/ImageScrollBox" -%}
{%- set p = c.placement if c.placement and c.placement.kind == "layout" else none %}
{%- set tw = c.props.thumb_size.width %}
{%- set th = c.props.thumb_size.height %}
{%- set sp = c.props.spacing %}
SizedBox(
  width: {{ p.width if p and p.width > 0 else 240 }},
  height: {{ p.height if p and p.height > 0 else 128 }},
  child: SingleChildScrollView(
    scrollDirection: {{ "Axis.horizontal" if c.props.orientation == "Horizontal" else "Axis.vertical" }},
    child: {{ "Row" if c.props.orientation == "Horizontal" else ("Column" if c.props.orientation == "Vertical" else "Wrap") }}(
      spacing: {{ sp }},
      {%- if c.props.orientation == "Grid" %}
      runSpacing: {{ sp }},
      {%- endif %}
      children: [
        for (var i = 0; i < c.items.length; i++)
          GestureDetector(
            onTap: c.enabled ? () => _send({{ n }}, 'on_select', freyaInput(index: i)) : null,
            child: Container(
              width: {{ tw }},
              height: {{ th }},
              padding: const EdgeInsets.all(2),
              decoration: c.index == i
                  ? BoxDecoration(
                      border: Border.all(color: Theme.of(context).colorScheme.primary, width: 2),
                      borderRadius: BorderRadius.circular(2),
                    )
                  : null,
              child: c.items[i].isEmpty ? const SizedBox() : Image.file(File(c.items[i]), fit: {{ fits[c.props.fit] }}),
            ),
          ),
      ],
    ),
  ),
)
{%- elif t == "backend:flutter/ListBox" -%}
SizedBox(
  height: {{ c.placement.height if c.placement and c.placement.kind == "absolute" else 120 }},
  child: DecoratedBox(
    decoration: BoxDecoration(border: Border.all(color: Theme.of(context).dividerColor)),
    child: ListView.builder(
      itemCount: c.items.length,
      itemBuilder: (context, i) => ListTile(
        dense: true,
        title: Text(c.items[i]),
        selected: c.index == i,
        onTap: c.enabled ? () => _send({{ n }}, 'on_select', freyaInput(index: i)) : null,
      ),
    ),
  ),
)
{%- elif t == "backend:flutter/DataGrid" -%}
SizedBox(
  height: {{ c.placement.height if c.placement and c.placement.kind == "absolute" else 160 }},
  child: c.items.isEmpty
      ? const SizedBox()
      : SingleChildScrollView(
          child: SingleChildScrollView(
            scrollDirection: Axis.horizontal,
            child: DataTable(
              showCheckboxColumn: false,
              columns: [for (final h in c.items) DataColumn(label: Text(h))],
              rows: [
                for (var i = 0; i < c.rows.length; i++)
                  DataRow(
                    selected: c.index == i,
                    onSelectChanged: c.enabled ? (_) => _send({{ n }}, 'on_select', freyaInput(index: i)) : null,
                    cells: [
                      for (var k = 0; k < c.items.length; k++)
                      {%- if c.props.editable and c.props.data_source %}
                        // Bearbeitbar: die gewählte Zeile als Eingabefelder; Enter
                        // speichert die Zeile, Esc verwirft sie.
                        DataCell(c.index == i
                            ? CallbackShortcuts(
                                bindings: {
                                  const SingleActivator(LogicalKeyboardKey.escape): () {
                                    _dropCells((key) => key.startsWith('{{ c.name }}:'));
                                    _send({{ n }}, 'cancel');
                                  },
                                },
                                child: TextField(
                                  controller: _cell({{ n }}, i, k, k < c.rows[i].length ? c.rows[i][k] : ''),
                                  enabled: c.enabled,
                                  decoration: const InputDecoration(isDense: true),
                                  onChanged: (text) => _send({{ n }}, 'edit_cell',
                                      freyaInput(index: i, number: k.toDouble(), text: text, checked: false)),
                                  onSubmitted: (text) => _send({{ n }}, 'edit_cell',
                                      freyaInput(index: i, number: k.toDouble(), text: text, checked: true)),
                                ),
                              )
                            : Text(k < c.rows[i].length ? c.rows[i][k] : '')),
                      {%- else %}
                        DataCell(Text(k < c.rows[i].length ? c.rows[i][k] : '')),
                      {%- endif %}
                    ],
                  ),
              ],
            ),
          ),
        ),
)
{%- elif t == "backend:flutter/Separator" -%}
{%- if c.props.vertical %}const SizedBox(height: 24, child: VerticalDivider(width: 16)){% else %}const Divider(height: 16){% endif -%}
{%- elif t == "core/Container" -%}
_w_{{ c.name }}()
{%- elif t == "backend:flutter/Card" -%}
Card(
  margin: EdgeInsets.zero,
  child: Column(
    crossAxisAlignment: CrossAxisAlignment.stretch,
    mainAxisSize: MainAxisSize.min,
    children: [
      if (c.caption.isNotEmpty)
        Padding(
          padding: const EdgeInsets.fromLTRB(12, 12, 12, 0),
          child: Text(c.caption, style: Theme.of(context).textTheme.titleMedium),
        ),
      _w_{{ c.name }}(),
    ],
  ),
)
{%- elif t == "backend:flutter/Tabs" -%}
_w_{{ c.name }}()
{%- else -%}
Text({{ c.type_name | dart_str }})
{%- endif -%}
{%- endmacro %}

{#- `c` with its state, style, tooltip; `null`-safe if hidden. -#}
{%- macro item(c) -%}
{%- set p = c.props -%}
Builder(builder: (context) {
  final c = _get({{ c.name | dart_str }});
  {%- if p.foreground.a > 0 or p.background.a > 0 or p.font_size > 0 or p.bold or p.italic %}
  return freyaFrame(c, freyaStyled(
    {{ control(c) | indent(4) }},
    {#- Knöpfe färbt ihr ButtonStyle. #}
    background: {{ "null" if c.type == "core/Button" else color(p.background) }},
    foreground: {{ "null" if c.type == "core/Button" else color(p.foreground) }},
    {%- if p.font_size > 0 %}
    fontSize: {{ p.font_size }},
    {%- endif %}
    bold: {{ "true" if p.bold else "false" }},
    italic: {{ "true" if p.italic else "false" }},
  ){% if c.type in containers %}, container: true{% endif %});
  {%- else %}
  return freyaFrame(c, {{ control(c) | indent(2) }}{% if c.type in containers %}, container: true{% endif %});
  {%- endif %}
})
{%- endmacro %}

{#- `c` placed in the layout `l` of its parent. -#}
{%- macro sized(c) -%}
{%- set p = c.placement -%}
{%- if p and p.kind == "layout" and (p.width > 0 or p.height > 0) -%}
{#- Wunschgröße aus dem Designer. -#}
SizedBox(width: {{ p.width if p.width > 0 else "null" }}, height: {{ p.height if p.height > 0 else "null" }}, child: {{ item(c) }})
{%- else -%}
{{ item(c) }}
{%- endif -%}
{%- endmacro %}

{%- macro placed(c, l) -%}
{%- set p = c.placement -%}
{%- set align = p.align if p and p.kind == "layout" else "Fill" -%}
{%- set wp = p.width_percent if p and p.kind == "layout" else 0 -%}
{%- if l.kind == "absolute" and p and p.kind == "absolute" -%}
{#- Anker: dx/dy = Änderung gegenüber der Entwurfsfläche (LayoutBuilder im Container). -#}
{%- set a = p.anchors -%}
Positioned(
  left: {% if a.left %}{{ p.x }}.0{% elif a.right %}{{ p.x }} + dx{% else %}{{ p.x }} + dx / 2{% endif %},
  top: {% if a.top %}{{ p.y }}.0{% elif a.bottom %}{{ p.y }} + dy{% else %}{{ p.y }} + dy / 2{% endif %},
  width: {% if a.left and a.right %}({{ p.width }} + dx).clamp(0.0, double.infinity){% else %}{{ p.width }}.0{% endif %},
  height: {% if a.top and a.bottom %}({{ p.height }} + dy).clamp(0.0, double.infinity){% else %}{{ p.height }}.0{% endif %},
  child: {{ item(c) }},
)
{%- elif l.kind in ["vertical", "custom"] and wp > 0 -%}
{#- Prozent der Breite (die Höhe in Prozent gibt es in der scrollenden Spalte nicht). -#}
FractionallySizedBox(widthFactor: {{ wp / 100 }}, alignment: {{ "Alignment.centerRight" if align == "End" else ("Alignment.center" if align == "Center" else "Alignment.centerLeft") }}, child: {% if p.height > 0 %}SizedBox(height: {{ p.height }}, child: {{ item(c) }}){% else %}{{ item(c) }}{% endif %})
{%- elif l.kind == "horizontal" and wp > 0 -%}
{#- Prozent der Breite in einer Zeile: Anteil am freien Platz. -#}
Expanded(flex: {{ wp }}, child: {% if p.height > 0 %}SizedBox(height: {{ p.height }}, child: {{ item(c) }}){% else %}{{ item(c) }}{% endif %})
{%- elif l.kind == "horizontal" and ((p and p.kind == "layout" and p.stretch) or (c.type in expanding and not (p and p.kind == "layout" and p.width > 0))) -%}
Expanded(child: {{ sized(c) }})
{%- elif l.kind in ["vertical", "custom"] and align == "Start" -%}
Align(alignment: Alignment.centerLeft, child: {{ sized(c) }})
{%- elif l.kind in ["vertical", "custom"] and align == "Center" -%}
Center(child: {{ sized(c) }})
{%- elif l.kind in ["vertical", "custom"] and align == "End" -%}
Align(alignment: Alignment.centerRight, child: {{ sized(c) }})
{%- else -%}
{{ sized(c) }}
{%- endif -%}
{%- endmacro %}
// ignore_for_file: non_constant_identifier_names, prefer_const_constructors, unused_element, unused_import

import 'dart:async';
import 'dart:io' show File;
import 'dart:ui' show AppExitResponse;

import 'package:flutter/material.dart';
{%- if widgets | selectattr("type", "eq", "backend:flutter/DataGrid") | selectattr("props.editable") | selectattr("props.data_source") | list %}
import 'package:flutter/services.dart';
{%- endif %}
import 'package:window_manager/window_manager.dart';

import '../src/rust/api.dart';
import 'freya.g.dart';

/// Form `{{ form.name }}`: its widgets, with the state and the handlers on
/// the Rust side (`src/{{ form.name }}.rs`).
class {{ view }} extends StatefulWidget {
  const {{ view }}({super.key});

  /// Name of the form on the Rust side.
  static const form = {{ form.name | dart_str }};

  /// Theme of the form (designer: `theme`).
  static const themeMode = ThemeMode.{% if root.props.theme == "Dark" %}dark{% elif root.props.theme == "Light" %}light{% else %}system{% endif %};

  /// The window as set in the designer (title, size, limits, position,
  /// start state); call before `runApp`. Uses window_manager.
  static Future<void> setupWindow() async {
    {%- set wp = root.props %}
    await windowManager.ensureInitialized();
    const options = WindowOptions(
      title: {{ wp.title | dart_str }},
      size: Size({{ wp.size.width }}, {{ wp.size.height }}),
    {%- if wp.min_size.width > 0 or wp.min_size.height > 0 %}
      minimumSize: Size({{ wp.min_size.width }}, {{ wp.min_size.height }}),
    {%- endif %}
    {%- if wp.max_size.width > 0 or wp.max_size.height > 0 %}
      maximumSize: Size({{ wp.max_size.width if wp.max_size.width > 0 else 100000 }}, {{ wp.max_size.height if wp.max_size.height > 0 else 100000 }}),
    {%- endif %}
      center: {{ "true" if wp.position == "Center" else "false" }},
    {%- if wp.start_state == "Fullscreen" %}
      fullScreen: true,
    {%- endif %}
    );
    await windowManager.waitUntilReadyToShow(options, () async {
    {%- if not wp.resizable %}
      await windowManager.setResizable(false);
    {%- endif %}
    {%- if wp.position == "Manual" %}
      await windowManager.setPosition(const Offset({{ wp.location.x }}, {{ wp.location.y }}));
    {%- endif %}
    {%- if wp.start_state == "Maximized" %}
      await windowManager.maximize();
    {%- endif %}
      await windowManager.show();
      await windowManager.focus();
    });
  }

  @override
  State<{{ view }}> createState() => _{{ view }}State();
}

class _{{ view }}State extends State<{{ view }}> {
  Map<String, FreyaControl> _controls = {};
  final Map<String, TextEditingController> _edits = {};
  final Map<String, TextEditingController> _cells = {};
  Timer? _poll;
  AppLifecycleListener? _lifecycle;

  @override
  void initState() {
    super.initState();
    _apply(freyaOpen(form: {{ view }}.form));
    {%- if data_bound %}
    // Daten, die im Hintergrund geladen werden, abholen.
    _poll = Timer.periodic(const Duration(milliseconds: 100), (_) {
      final state = freyaPoll(form: {{ view }}.form);
      if (state != null) _take(state);
    });
    {%- endif %}
    _lifecycle = AppLifecycleListener(
      onExitRequested: () async =>
          freyaClose(form: {{ view }}.form) ? AppExitResponse.exit : AppExitResponse.cancel,
    );
  }

  @override
  void dispose() {
    _poll?.cancel();
    _lifecycle?.dispose();
    for (final edit in [..._edits.values, ..._cells.values]) {
      edit.dispose();
    }
    super.dispose();
  }

  void _apply(List<FreyaControl> state) {
    final old = _controls;
    _controls = {for (final c in state) c.name: c};
    // Eingabefelder bearbeitbarer Tabellen: neu, wenn eine andere Zeile gewählt ist.
    _dropCells((key) {
      final name = key.split(':').first;
      final before = old[name];
      final now = _controls[name];
      return before == null || now == null || before.index != now.index || before.rows.length != now.rows.length;
    });
    // Texte, die ein Handler geändert hat, in die Eingabefelder übernehmen.
    _edits.forEach((name, edit) {
      final text = _controls[name]?.text;
      if (text != null && text != edit.text) edit.text = text;
    });
  }

  void _take(List<FreyaControl> state) {
    if (mounted) setState(() => _apply(state));
  }

  void _send(String widget, String event, [FreyaInput? input]) {
    _take(freyaEvent(form: {{ view }}.form, widget: widget, event: event, input: input ?? freyaInput()));
  }

  FreyaControl _get(String name) => _controls[name] ?? freyaEmpty(name);

  TextEditingController _edit(String name) =>
      _edits.putIfAbsent(name, () => TextEditingController(text: _get(name).text));

  /// Drops (and frees) the cell fields whose key matches `test`.
  void _dropCells(bool Function(String key) test) {
    for (final key in _cells.keys.where(test).toList()) {
      _cells.remove(key)?.dispose();
    }
  }

  /// The text field of a cell of an editable table (`<widget>:<row>:<column>`).
  TextEditingController _cell(String name, int row, int column, String text) =>
      _cells.putIfAbsent('$name:$row:$column', () => TextEditingController(text: text));

  @override
  Widget build(BuildContext context) {
    {%- set rp = root.props %}
    Widget body = SingleChildScrollView(child: _w_{{ root.name }}());
    {%- if rp.background_image %}
    body = freyaBackground({{ rp.background_image | dart_str }}, {{ fits[rp.background_fit] if rp.background_fit in fits else "BoxFit.cover" }}, body);
    {%- endif %}
    body = freyaStyled(
      body,
      foreground: {{ color(rp.foreground) }},
      {%- if rp.font_size > 0 %}
      fontSize: {{ rp.font_size }},
      {%- endif %}
      {%- if rp.font_family %}
      fontFamily: {{ rp.font_family | dart_str }},
      {%- endif %}
    );
    return Scaffold(
      backgroundColor: {{ color(rp.background) }},
      body: Column(
        crossAxisAlignment: CrossAxisAlignment.stretch,
        children: [
        {%- for m in menus %}
          freyaMenuBar(_get({{ m.name | dart_str }}), (path) => _send({{ m.name | dart_str }}, 'on_select', freyaInput(text: path))),
        {%- endfor %}
          Expanded(
            child: freyaFrame(_get({{ root.name | dart_str }}), body, container: true),
          ),
        ],
      ),
    );
  }
{%- for w in widgets if w.type in containers %}

  /// The children of `{{ w.name }}`.
  Widget _w_{{ w.name }}() {
    {%- set kids = w.children %}
    {%- if w.type == "backend:flutter/Tabs" %}
    final c = _get({{ w.name | dart_str }});
    final page = c.index.clamp(0, {{ [kids | length - 1, 0] | max }}).toInt();
    const fallback = [{% for k in kids %}{{ k.name | dart_str }}, {% endfor %}];
    return DefaultTabController(
      key: ValueKey(page),
      length: {{ [kids | length, 1] | max }},
      initialIndex: page,
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.stretch,
        mainAxisSize: MainAxisSize.min,
        children: [
          TabBar(
            isScrollable: true,
            tabAlignment: TabAlignment.start,
            tabs: [
            {%- if kids %}
              for (var i = 0; i < fallback.length; i++)
                Tab(text: i < c.items.length ? c.items[i] : fallback[i]),
            {%- else %}
              const Tab(text: ''),
            {%- endif %}
            ],
            onTap: (i) => _send({{ w.name | dart_str }}, 'on_page', freyaInput(index: i)),
          ),
          const SizedBox(height: 8),
          {%- if kids %}
          [
          {%- for k in kids %}
            {{ item(k) | indent(12) }},
          {%- endfor %}
          ][page],
          {%- endif %}
        ],
      ),
    );
    {%- else %}
    {%- set l = w.layout or default_layout %}
    {%- set pad = "EdgeInsets.fromLTRB(" ~ l.padding.left ~ ", " ~ l.padding.top ~ ", " ~ l.padding.right ~ ", " ~ l.padding.bottom ~ ")" %}
    {%- if l.kind == "absolute" %}
    {%- set ext = namespace(w=0, h=0, grow_x=false, grow_y=false, dw=0, dh=0) %}
    {%- for c in kids if c.placement and c.placement.kind == "absolute" %}
    {%- set ext.w = [ext.w, c.placement.x + c.placement.width] | max %}
    {%- set ext.h = [ext.h, c.placement.y + c.placement.height] | max %}
    {%- set ext.dw = c.placement.area.width %}
    {%- set ext.dh = c.placement.area.height %}
    {%- if c.placement.anchors.right or not c.placement.anchors.left %}{% set ext.grow_x = true %}{% endif %}
    {%- if c.placement.anchors.bottom or not c.placement.anchors.top %}{% set ext.grow_y = true %}{% endif %}
    {%- endfor %}
    // Absolut: Fläche so groß wie das äußerste Kind; mit Ankern rechts bzw.
    // unten so groß wie der verfügbare (begrenzte) Platz.
    return Padding(
      padding: {{ pad }},
      child: LayoutBuilder(builder: (context, box) {
        final width = {% if ext.grow_x %}box.maxWidth.isFinite && box.maxWidth > {{ ext.w }} ? box.maxWidth : {% endif %}{{ ext.w }}.0;
        final height = {% if ext.grow_y %}box.maxHeight.isFinite && box.maxHeight > {{ ext.h }} ? box.maxHeight : {% endif %}{{ ext.h }}.0;
        // ignore: unused_local_variable
        final dx = width - {{ ext.dw }};
        // ignore: unused_local_variable
        final dy = height - {{ ext.dh }};
        return SizedBox(
          width: width,
          height: height,
          child: Stack(clipBehavior: Clip.none, children: [
          {%- for c in kids if c.placement and c.placement.kind == "absolute" %}
            if (_get({{ c.name | dart_str }}).visible) {{ placed(c, l) | indent(12) }},
          {%- endfor %}
          ]),
        );
      }),
    );
    {%- elif l.kind == "grid" %}
    return Padding(
      padding: {{ pad }},
      child: freyaGrid({{ l.columns or 1 }}, {{ l.spacing }}, [
      {%- for c in kids %}
        {%- set p = c.placement %}
        {%- if p and p.kind == "layout" and (p.width > 0 or p.height > 0) %}
        _get({{ c.name | dart_str }}).visible ? Align(alignment: Alignment.centerLeft, child: {{ sized(c) | indent(8) }}) : const SizedBox(),
        {%- else %}
        _get({{ c.name | dart_str }}).visible ? {{ item(c) | indent(8) }} : const SizedBox(),
        {%- endif %}
      {%- endfor %}
      ]),
    );
    {%- elif l.kind == "stack" %}
    return Padding(
      padding: {{ pad }},
      child: {% if kids %}{{ item(kids[0]) | indent(6) }}{% else %}const SizedBox(){% endif %},
    );
    {%- elif l.kind == "horizontal" %}
    return Padding(
      padding: {{ pad }},
      child: Row(
        crossAxisAlignment: CrossAxisAlignment.center,
        spacing: {{ l.spacing }},
        children: [
        {%- set total = namespace(w=0) %}
        {%- for c in kids %}
          {%- if c.placement and c.placement.kind == "layout" %}{% set total.w = total.w + c.placement.width_percent %}{% endif %}
          if (_get({{ c.name | dart_str }}).visible) {{ placed(c, l) | indent(10) }},
        {%- endfor %}
        {%- if total.w > 0 and total.w < 100 %}
          Spacer(flex: {{ 100 - total.w }}),
        {%- endif %}
        ],
      ),
    );
    {%- else %}
    return Padding(
      padding: {{ pad }},
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.stretch,
        mainAxisSize: MainAxisSize.min,
        spacing: {{ l.spacing }},
        children: [
        {%- for c in kids %}
          if (_get({{ c.name | dart_str }}).visible) {{ placed(c, l) | indent(10) }},
        {%- endfor %}
        ],
      ),
    );
    {%- endif %}
    {%- endif %}
  }
{%- endfor %}
}
