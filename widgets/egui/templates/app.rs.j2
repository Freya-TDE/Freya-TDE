/// `widget` with its own colours and font size (a style scope).
#[allow(dead_code)]
pub fn styled<'a>(
    foreground: Option<eframe::egui::Color32>,
    background: Option<eframe::egui::Color32>,
    font_size: Option<f32>,
    widget: impl eframe::egui::Widget + 'a,
) -> impl eframe::egui::Widget + 'a {
    move |ui: &mut eframe::egui::Ui| {
        ui.scope(|ui| {
            if let Some(color) = foreground {
                ui.visuals_mut().override_text_color = Some(color);
            }
            if let Some(color) = background {
                let visuals = ui.visuals_mut();
                for state in [
                    &mut visuals.widgets.inactive,
                    &mut visuals.widgets.hovered,
                    &mut visuals.widgets.active,
                ] {
                    state.weak_bg_fill = color;
                    state.bg_fill = color;
                }
                visuals.extreme_bg_color = color;
            }
            if let Some(size) = font_size {
                ui.style_mut().override_font_id = Some(eframe::egui::FontId::proportional(size));
            }
            ui.add(widget)
        })
        .inner
    }
}

/// A background picture (`file` relative to the working directory) in `rect`;
/// `fit`: Cover, Stretch, Contain or Center.
#[allow(dead_code)]
pub fn background(ui: &eframe::egui::Ui, rect: eframe::egui::Rect, file: &str, fit: &str) {
    use eframe::egui;
    let path = std::env::current_dir().unwrap_or_default().join(file);
    let image = egui::Image::new(format!("file://{}", path.display()));
    let Ok(egui::load::TexturePoll::Ready { texture }) = image.load_for_size(ui.ctx(), rect.size())
    else {
        return;
    };
    let size = texture.size;
    if size.x <= 0.0 || size.y <= 0.0 {
        return;
    }
    let scale = egui::vec2(rect.width() / size.x, rect.height() / size.y);
    let target = match fit {
        "Stretch" => rect,
        "Contain" => egui::Rect::from_center_size(rect.center(), size * scale.x.min(scale.y)),
        "Center" => egui::Rect::from_center_size(rect.center(), size),
        _ => egui::Rect::from_center_size(rect.center(), size * scale.x.max(scale.y)),
    };
    let uv = egui::Rect::from_min_max(egui::pos2(0.0, 0.0), egui::pos2(1.0, 1.0));
    ui.painter()
        .with_clip_rect(rect)
        .image(texture.id, target, uv, egui::Color32::WHITE);
}

/// Place of an absolutely placed widget in `area` (like Delphi's Anchors):
/// `rect` = x, y, width, height as designed for an area of size `design`;
/// `anchors` = left, top, right, bottom.
#[allow(dead_code)]
pub fn anchored(
    area: eframe::egui::Rect,
    design: (i32, i32),
    rect: [i32; 4],
    anchors: [bool; 4],
) -> eframe::egui::Rect {
    let axis = |start: bool, end: bool, pos: i32, len: i32, delta: i32| match (start, end) {
        (true, true) => (pos, (len + delta).max(0)),
        (false, true) => (pos + delta, len),
        (false, false) => (pos + delta / 2, len),
        (true, false) => (pos, len),
    };
    let (x, w) = axis(anchors[0], anchors[2], rect[0], rect[2], area.width() as i32 - design.0);
    let (y, h) = axis(anchors[1], anchors[3], rect[1], rect[3], area.height() as i32 - design.1);
    eframe::egui::Rect::from_min_size(
        area.min + eframe::egui::vec2(x as f32, y as f32),
        eframe::egui::vec2(w as f32, h as f32),
    )
}
