{#- egui: a form draws itself every frame from its state (appended to
    <form>.gen.rs). Every container gets a method `freya_ui_<name>` that lays
    out its direct children; events are checked right after a widget is
    drawn and call the handlers in <form>.rs. -#}
{%- set containers = ["core/Form", "core/Container", "backend:egui/CollapsingHeader", "backend:egui/Tabs"] %}
{#- Wie die Theme-Tabelle des Designers (designer/themes/linux.toml): Rand 12, Abstand 8. -#}
{%- set default_layout = {"kind": "vertical", "spacing": 8, "padding": {"left": 12, "top": 12, "right": 12, "bottom": 12}} %}
{#- Widgets that keep their natural width even with align Fill. -#}
{%- set natural = ["core/Label", "core/CheckBox", "backend:egui/RadioButton", "backend:egui/Switch", "backend:egui/Hyperlink", "backend:egui/DragValue", "backend:egui/Slider"] %}
{%- set menus = components | selectattr("type", "eq", "backend:egui/MainMenu") | selectattr("field") | list %}

{#- A colour property as `egui::Color32` (or `None` if not set). -#}
{%- macro color(value) -%}
{%- if value.a > 0 %}Some(egui::Color32::from_rgba_unmultiplied({{ value.r }}, {{ value.g }}, {{ value.b }}, {{ value.a }})){% else %}None{% endif -%}
{%- endmacro %}

{#- A caption with the widget's bold/italic. -#}
{%- macro rich(c, text) -%}
{%- if c.props.bold or c.props.italic -%}
egui::RichText::new({{ text }}){% if c.props.bold %}.strong(){% endif %}{% if c.props.italic %}.italics(){% endif %}
{%- else -%}
{{ text }}
{%- endif -%}
{%- endmacro %}

{#- The widget of `c` as an `impl egui::Widget` expression. `fill`: take the
    full width (vertical layouts with align Fill). -#}
{%- macro widget(c, fill) -%}
{%- set t = c.type -%}
{%- if t == "core/Label" -%}
egui::Label::new({{ rich(c, "self." ~ c.name ~ ".value.as_str()") }}){% if c.props.wrap %}.wrap(){% else %}.extend(){% endif %}
{%- elif t == "core/Button" -%}
egui::Button::new({{ rich(c, "self." ~ c.name ~ ".caption.as_str()") }})
{%- elif t == "core/Edit" -%}
egui::TextEdit::singleline(&mut self.{{ c.name }}.value)
    {%- if c.props.placeholder %}.hint_text({{ c.rust.placeholder }}){% endif -%}
    {%- if c.props.password %}.password(true){% endif -%}
    {%- if c.props.read_only %}.interactive(false){% endif -%}
    {%- if c.props.max_length > 0 %}.char_limit({{ c.props.max_length }}){% endif -%}
    {%- if fill %}.desired_width(f32::INFINITY){% endif %}
{%- elif t == "core/CheckBox" -%}
egui::Checkbox::new(&mut self.{{ c.name }}.value, {{ rich(c, "self." ~ c.name ~ ".caption.as_str()") }})
{%- elif t == "backend:egui/RadioButton" -%}
egui::RadioButton::new(self.{{ c.name }}.value, {{ rich(c, "self." ~ c.name ~ ".caption.as_str()") }})
{%- elif t == "backend:egui/Switch" -%}
crate::app::switch(&mut self.{{ c.name }}.value)
{%- elif t == "backend:egui/DragValue" -%}
egui::DragValue::new(&mut self.{{ c.name }}.value).range({{ c.rust.minimum }}..={{ c.rust.maximum }}).speed({{ c.rust.step }}).fixed_decimals({{ c.props.digits }})
{%- elif t == "backend:egui/Slider" -%}
egui::Slider::new(&mut self.{{ c.name }}.value, {{ c.rust.minimum }}..={{ c.rust.maximum }}).step_by({{ c.rust.step }}).show_value({{ c.rust.show_value }})
{%- elif t == "backend:egui/ProgressBar" -%}
|ui: &mut egui::Ui| {
    let bar = egui::ProgressBar::new(self.{{ c.name }}.value);
    if self.{{ c.name }}.caption.is_empty() {
        ui.add(bar)
    } else {
        ui.add(bar.text(self.{{ c.name }}.caption.as_str()))
    }
}
{%- elif t == "backend:egui/ComboBox" -%}
|ui: &mut egui::Ui| {
    let control = &mut self.{{ c.name }};
    let shown = control.items.get(control.value).cloned().unwrap_or_default();
    let mut changed = false;
    let mut response = egui::ComboBox::from_id_salt("{{ form.name }}.{{ c.name }}")
        .selected_text(shown)
        {%- if fill %}
        .width(ui.available_width())
        {%- endif %}
        .show_ui(ui, |ui| {
            for (index, item) in control.items.iter().enumerate() {
                if ui.selectable_label(control.value == index, item.as_str()).clicked() {
                    control.value = index;
                    changed = true;
                }
            }
        })
        .response;
    if changed {
        response.mark_changed();
    }
    response
}
{%- elif t == "backend:egui/ListBox" -%}
|ui: &mut egui::Ui| {
    let control = &mut self.{{ c.name }};
    let mut changed = false;
    let mut response = egui::Frame::group(ui.style())
        .show(ui, |ui| {
            egui::ScrollArea::vertical()
                .id_salt("{{ form.name }}.{{ c.name }}")
                .max_height(120.0)
                .show(ui, |ui| {
                    ui.set_min_width(ui.available_width());
                    for (index, item) in control.items.iter().enumerate() {
                        let selected = control.value == index as i32;
                        if ui.selectable_label(selected, item.as_str()).clicked() {
                            control.value = index as i32;
                            changed = true;
                        }
                    }
                });
        })
        .response;
    if changed {
        response.mark_changed();
    }
    response
}
{%- elif t == "backend:egui/DataGrid" -%}
|ui: &mut egui::Ui| {
    let control = &mut self.{{ c.name }};
    let mut clicked = None;
    let mut response = egui::Frame::group(ui.style())
        .show(ui, |ui| {
            egui::ScrollArea::both()
                .id_salt("{{ form.name }}.{{ c.name }}")
                .max_height(160.0)
                .show(ui, |ui| {
                    ui.set_min_width(ui.available_width());
                    egui::Grid::new("{{ form.name }}.{{ c.name }}.grid")
                        .striped(true)
                        .show(ui, |ui| {
                            for header in &control.value.headers {
                                ui.strong(header.as_str());
                            }
                            ui.end_row();
                        {%- if c.props.editable and c.props.data_source %}
                            // Bearbeitbar: Doppelklick bearbeitet die Zelle, Enter speichert
                            // die Zeile, Esc verwirft sie.
                            for index in 0..control.value.rows.len() {
                                let selected = control.value.selected == Some(index);
                                for column in 0..control.value.rows[index].len() {
                                    let editing = control
                                        .value
                                        .editing
                                        .as_ref()
                                        .is_some_and(|e| e.0 == index && e.1 == column);
                                    if editing {
                                        let focus = std::mem::take(&mut control.value.focus);
                                        let Some(cell) = control.value.editing.as_mut() else { continue };
                                        let edit = ui.add(egui::TextEdit::singleline(&mut cell.2).desired_width(120.0));
                                        if focus {
                                            edit.request_focus();
                                        }
                                        if edit.lost_focus() {
                                            let (enter, escape) = ui.input(|i| {
                                                (i.key_pressed(egui::Key::Enter), i.key_pressed(egui::Key::Escape))
                                            });
                                            if let Some((row, column, text)) = control.value.editing.take() {
                                                if escape {
                                                    control.value.cancel = true;
                                                } else {
                                                    let changed = control.value.rows[row][column] != text;
                                                    if changed || enter {
                                                        control.value.rows[row][column] = text.clone();
                                                        control.value.commits.push((row, column, text, enter));
                                                    }
                                                }
                                            }
                                        }
                                        continue;
                                    }
                                    let text = control.value.rows[index][column].clone();
                                    let cell = ui.selectable_label(selected, text.as_str());
                                    if cell.clicked() {
                                        clicked = Some(index);
                                    }
                                    if cell.double_clicked() {
                                        clicked = Some(index);
                                        control.value.editing = Some((index, column, text));
                                        control.value.focus = true;
                                    }
                                }
                                ui.end_row();
                            }
                        {%- else %}
                            for (index, row) in control.value.rows.iter().enumerate() {
                                let selected = control.value.selected == Some(index);
                                for cell in row {
                                    if ui.selectable_label(selected, cell.as_str()).clicked() {
                                        clicked = Some(index);
                                    }
                                }
                                ui.end_row();
                            }
                        {%- endif %}
                        });
                });
        })
        .response;
    if let Some(index) = clicked {
        if control.value.selected != Some(index) {
            control.value.selected = Some(index);
            response.mark_changed();
        }
    }
    response
}
{%- elif t == "backend:egui/TextEdit" -%}
egui::TextEdit::multiline(&mut self.{{ c.name }}.value).desired_rows({{ c.props.rows }})
    {%- if c.props.monospace %}.font(egui::TextStyle::Monospace){% endif -%}
    {%- if c.props.read_only %}.interactive(false){% endif -%}
    {%- if fill %}.desired_width(f32::INFINITY){% endif %}
{%- elif t == "backend:egui/Hyperlink" -%}
egui::Hyperlink::from_label_and_url(
    if self.{{ c.name }}.caption.is_empty() { self.{{ c.name }}.value.as_str() } else { self.{{ c.name }}.caption.as_str() },
    self.{{ c.name }}.value.as_str(),
)
{%- elif t == "backend:egui/Separator" -%}
egui::Separator::default(){% if c.props.vertical %}.vertical(){% endif %}
{%- else -%}
egui::Label::new("{{ c.type_name }}")
{%- endif -%}
{%- endmacro %}

{#- A child container: its own method, inside a collapsing header if it is one. -#}
{%- macro container(c) -%}
|ui: &mut egui::Ui| {
    ui.add_enabled_ui(self.{{ c.name }}.enabled, |ui| {
    {%- if c.type == "backend:egui/CollapsingHeader" %}
        let title = self.{{ c.name }}.caption.clone();
        egui::CollapsingHeader::new(title)
            .id_salt("{{ form.name }}.{{ c.name }}")
            .default_open({{ c.rust.open }})
            .show(ui, |ui| self.freya_ui_{{ c.name }}(ui));
    {%- else %}
        self.freya_ui_{{ c.name }}(ui);
    {%- endif %}
    })
    .response
}
{%- endmacro %}

{#- What happens after `c` was drawn (`response`). `radios`: the radio
    buttons of the same container. -#}
{%- macro events(c, radios) -%}
let response = self.{{ c.name }}.hint(response);
{%- set t = c.type %}
{%- if t == "backend:egui/RadioButton" %}
if response.clicked() {
    self.{{ c.name }}.value = true;
    {%- for o in radios if o.name != c.name %}
    self.{{ o.name }}.value = false;
    {%- endfor %}
    {%- if c.events.on_toggle %}
    self.{{ c.events.on_toggle }}(true);
    {%- endif %}
}
{%- endif %}
{%- if t == "backend:egui/DataGrid" and c.props.editable and c.props.data_source %}
// Bearbeitete Zellen, Esc und Zeilenwechsel an die Datenbindung.
for (row, column, text, post) in std::mem::take(&mut self.{{ c.name }}.value.commits) {
    let _ = self.{{ c.name }}_edit_cell(row, column, &text);
    if post {
        self.{{ c.name }}_post();
    }
}
if std::mem::take(&mut self.{{ c.name }}.value.cancel) {
    self.{{ c.name }}_cancel();
}
if response.changed() {
    let index = self.{{ c.name }}.value.selected;
    self.{{ c.name }}_row_changed(index);
}
{%- endif %}
{%- for event, handler in c.events | items if handler %}
{%- set key = t ~ "." ~ event %}
{%- if key == "core/Button.on_click" %}
if response.clicked() {
    self.{{ handler }}();
}
{%- elif key in ["core/Edit.on_change", "backend:egui/TextEdit.on_change"] %}
if response.changed() {
    let text = self.{{ c.name }}.value.clone();
    self.{{ handler }}(&text);
}
{%- elif key == "core/Edit.on_submit" %}
if response.lost_focus() && ui.ctx().input(|i| i.key_pressed(egui::Key::Enter)) {
    self.{{ handler }}();
}
{%- elif key in ["core/CheckBox.on_toggle", "backend:egui/Switch.on_toggle"] %}
if response.changed() {
    let checked = self.{{ c.name }}.value;
    self.{{ handler }}(checked);
}
{%- elif key in ["backend:egui/DragValue.on_change", "backend:egui/Slider.on_change"] %}
if response.changed() {
    let value = self.{{ c.name }}.value;
    self.{{ handler }}(value);
}
{%- elif key == "backend:egui/ComboBox.on_select" %}
if response.changed() {
    let index = self.{{ c.name }}.value as u32;
    self.{{ handler }}(index);
}
{%- elif key == "backend:egui/DataGrid.on_select" %}
if response.changed() {
    let index = self.{{ c.name }}.value.selected.map_or(-1, |i| i as i32);
    self.{{ handler }}(index);
}
{%- elif key == "backend:egui/ListBox.on_select" %}
if response.changed() {
    let index = self.{{ c.name }}.value;
    self.{{ handler }}(index);
}
{%- endif %}
{%- endfor %}
let _ = response;
{%- endmacro %}

{%- if root %}
#[allow(unused_imports)]
use eframe::egui;

#[allow(clippy::needless_borrow)]
impl {{ form.struct }} {
    /// Window options from the designer (title, size, resizable).
    pub fn native_options() -> eframe::NativeOptions {
        eframe::NativeOptions {
            viewport: egui::ViewportBuilder::default()
                .with_title({{ root.rust.title }})
                .with_inner_size([{{ root.props.size.width }} as f32, {{ root.props.size.height }} as f32])
                .with_resizable({{ root.rust.resizable }})
            {%- set rp = root.props %}
            {%- if rp.min_size.width > 0 or rp.min_size.height > 0 %}
                .with_min_inner_size([{{ rp.min_size.width }} as f32, {{ rp.min_size.height }} as f32])
            {%- endif %}
            {%- if rp.max_size.width > 0 or rp.max_size.height > 0 %}
                .with_max_inner_size([{{ rp.max_size.width if rp.max_size.width > 0 else 100000 }} as f32, {{ rp.max_size.height if rp.max_size.height > 0 else 100000 }} as f32])
            {%- endif %}
            {%- if rp.position == "Manual" %}
                .with_position([{{ rp.location.x }} as f32, {{ rp.location.y }} as f32])
            {%- endif %}
            {%- if rp.start_state == "Maximized" %}
                .with_maximized(true)
            {%- elif rp.start_state == "Fullscreen" %}
                .with_fullscreen(true)
            {%- endif %},
            centered: {{ "true" if rp.position == "Center" else "false" }},
            ..Default::default()
        }
    }

    /// Theme and picture loaders, once before the first frame.
    pub fn freya_setup(ctx: &egui::Context) {
        egui_extras::install_image_loaders(ctx);
    {%- if root.props.theme == "Dark" %}
        ctx.set_theme(egui::ThemePreference::Dark);
    {%- elif root.props.theme == "Light" %}
        ctx.set_theme(egui::ThemePreference::Light);
    {%- endif %}
    }

    /// The window title (the caption of `{{ root.name }}`).
    pub fn title(&self) -> String {
        self.{{ root.name }}.caption.clone()
    }

    /// Called once before the first frame.
    pub fn freya_created(&mut self) {
        // Daten der Listen laden (im Hintergrund).
        self.freya_start_data();
    {%- if root.events.on_create %}
        self.{{ root.events.on_create }}();
    {%- endif %}
    }

    /// Draws the form (every frame) and handles its events.
    pub fn ui(&mut self, ui: &mut egui::Ui) {
    {%- if data_bound %}
        // Geladene Daten übernehmen; ist ein Ladevorgang fertig, zeichnet egui neu.
        let waker_id = egui::Id::unique("freya_waker");
        if !ui.ctx().data(|d| d.get_temp::<bool>(waker_id).unwrap_or(false)) {
            let ctx = ui.ctx().clone();
            crate::app::freya_set_waker(move || ctx.request_repaint());
            ui.ctx().data_mut(|d| d.insert_temp(waker_id, true));
        }
    {%- endif %}
        self.freya_take_data();
        // Titel nachführen, wenn ein Handler ihn geändert hat.
        let title_id = egui::Id::unique("freya_title");
        let title_changed = ui.ctx().data_mut(|d| {
            let shown: &mut String = d.get_temp_mut_or_default(title_id);
            let changed = *shown != self.{{ root.name }}.caption;
            if changed {
                shown.clone_from(&self.{{ root.name }}.caption);
            }
            changed
        });
        if title_changed {
            ui.ctx().send_viewport_cmd(egui::ViewportCommand::Title(self.title()));
        }
        if ui.ctx().input(|i| i.viewport().close_requested()) {
        {%- if root.events.on_close %}
            if !self.{{ root.events.on_close }}() {
                ui.ctx().send_viewport_cmd(egui::ViewportCommand::CancelClose);
            }
        {%- endif %}
        }
    {%- for m in menus %}
        egui::Panel::top("{{ form.name }}.{{ m.name }}").show(ui, |ui| {
            let chosen = crate::app::menu_bar(ui, &self.{{ m.name }}.items);
            {%- if m.events.on_select %}
            if let Some(item) = chosen {
                self.{{ m.events.on_select }}(&item);
            }
            {%- else %}
            let _ = chosen;
            {%- endif %}
        });
    {%- endfor %}
        {%- set rp = root.props %}
        egui::CentralPanel::default()
            .frame(
                egui::Frame::central_panel(&ui.style())
                    .inner_margin(egui::Margin::ZERO)
                {%- if rp.background.a > 0 %}
                    .fill(egui::Color32::from_rgba_unmultiplied({{ rp.background.r }}, {{ rp.background.g }}, {{ rp.background.b }}, {{ rp.background.a }}))
                {%- endif %},
            )
            .show(ui, |ui| {
            {%- if rp.background_image %}
                crate::app::background(ui, ui.max_rect(), {{ root.rust.background_image }}, {{ rp.background_fit | rust_str }});
            {%- endif %}
            {%- if rp.foreground.a > 0 %}
                ui.visuals_mut().override_text_color = Some(egui::Color32::from_rgb({{ rp.foreground.r }}, {{ rp.foreground.g }}, {{ rp.foreground.b }}));
            {%- endif %}
            {%- if rp.font_size > 0 %}
                ui.style_mut().override_font_id = Some(egui::FontId::proportional({{ rp.font_size }} as f32));
            {%- endif %}
                ui.add_enabled_ui(self.{{ root.name }}.enabled, |ui| self.freya_ui_{{ root.name }}(ui));
            });
    }
{%- for w in widgets if w.field and w.type in containers %}

    /// The children of `{{ w.name }}`.
    #[allow(unused_variables)]
    fn freya_ui_{{ w.name }}(&mut self, ui: &mut egui::Ui) {
    {%- set kids = w.children | selectattr("field") | list %}
    {%- set radios = kids | selectattr("type", "eq", "backend:egui/RadioButton") | list %}
    {%- if w.type == "backend:egui/Tabs" %}
        // Reiterleiste, darunter nur die gewählte Seite.
        let before = self.{{ w.name }}.value;
        ui.horizontal(|ui| {
        {%- for c in kids %}
            let title = self.{{ w.name }}.items.get({{ loop.index0 }}).cloned().unwrap_or_else(|| "{{ c.name }}".to_owned());
            if ui.selectable_label(self.{{ w.name }}.value == {{ loop.index0 }}, title).clicked() {
                self.{{ w.name }}.value = {{ loop.index0 }};
            }
        {%- endfor %}
        });
        ui.separator();
        {%- if w.events.on_page %}
        if self.{{ w.name }}.value != before {
            let page = self.{{ w.name }}.value as u32;
            self.{{ w.events.on_page }}(page);
        }
        {%- else %}
        let _ = before;
        {%- endif %}
        match self.{{ w.name }}.value {
        {%- for c in kids %}
            {{ loop.index0 }} => {
                if self.{{ c.name }}.visible {
                {%- if c.type in containers %}
                    let response = ui.add({{ container(c) }});
                {%- else %}
                    let response = ui.add({{ widget(c, false) }});
                {%- endif %}
                    {{ events(c, []) | indent(20) }}
                }
            }
        {%- endfor %}
            _ => {}
        }
    {%- else %}
    {%- set l = w.layout or default_layout %}
        egui::Frame::NONE
            .inner_margin(egui::Margin {
                left: {{ [l.padding.left, 127] | min }},
                right: {{ [l.padding.right, 127] | min }},
                top: {{ [l.padding.top, 127] | min }},
                bottom: {{ [l.padding.bottom, 127] | min }},
            })
            .show(ui, |ui| {
                ui.spacing_mut().item_spacing = egui::vec2({{ l.spacing }} as f32, {{ l.spacing }} as f32);
            {%- set pct = namespace(any=false) %}
            {%- for c in kids if c.placement and c.placement.kind == "layout" and (c.placement.width_percent > 0 or c.placement.height_percent > 0) %}{% set pct.any = true %}{% endfor %}
            {%- if pct.any %}
                // Inhalt des Containers: Bezug für Größen in Prozent.
                let full = ui.available_size();
            {%- endif %}
            {%- if l.kind == "absolute" %}
            {%- set grow = namespace(x=false, y=false, area="(0, 0)") %}
            {%- for c in kids if c.placement and c.placement.kind == "absolute" %}
            {%- set a = c.placement.anchors %}
            {%- if a.right or not a.left %}{% set grow.x = true %}{% endif %}
            {%- if a.bottom or not a.top %}{% set grow.y = true %}{% endif %}
            {%- set grow.area = "(" ~ c.placement.area.width ~ ", " ~ c.placement.area.height ~ ")" %}
            {%- endfor %}
                // Absolut: Fläche so groß wie das äußerste Kind; mit Ankern
                // rechts bzw. unten so groß wie der verfügbare Platz.
                let extent = [{% for c in kids %}{% set p = c.placement %}{% if p and p.kind == "absolute" %}({{ p.x + p.width }}, {{ p.y + p.height }}), {% endif %}{% endfor %}(0, 0)]
                    .iter()
                    .fold((0, 0), |a, b| (a.0.max(b.0), a.1.max(b.1)));
                let size = egui::vec2(
                    {% if grow.x %}ui.available_width().max(extent.0 as f32){% else %}extent.0 as f32{% endif %},
                    {% if grow.y %}ui.available_height().max(extent.1 as f32){% else %}extent.1 as f32{% endif %},
                );
                let (area, _) = ui.allocate_exact_size(size, egui::Sense::hover());
                let design: (i32, i32) = {{ grow.area }};
            {%- elif l.kind == "horizontal" %}
                ui.horizontal(|ui| {
            {%- elif l.kind == "grid" %}
                egui::Grid::new("{{ form.name }}.{{ w.name }}")
                    .num_columns({{ l.columns or 1 }})
                    .spacing([{{ l.spacing }} as f32, {{ l.spacing }} as f32])
                    .show(ui, |ui| {
            {%- else %}
                ui.vertical(|ui| {
            {%- endif %}
            {%- for c in kids if l.kind != "stack" or loop.first %}
                {%- set p = c.placement %}
                {%- set align = p.align if p and p.kind == "layout" else "Fill" %}
                {%- if p and p.kind == "layout" and (p.width_percent > 0 or p.height_percent > 0) and align == "Fill" %}{% set align = "Start" %}{% endif %}
                {%- set item = container(c) if c.type in containers else widget(c, l.kind == "vertical" and align == "Fill" and c.type not in natural) %}
                {%- if c.type not in containers and (c.props.foreground.a > 0 or c.props.background.a > 0 or c.props.font_size > 0) %}
                {%- set item = "crate::app::styled(" ~ color(c.props.foreground) ~ ", " ~ color(c.props.background) ~ ", " ~ (("Some(" ~ c.props.font_size ~ " as f32)") if c.props.font_size > 0 else "None") ~ ", " ~ item ~ ")" %}
                {%- endif %}
                    if self.{{ c.name }}.visible {
                    {%- if l.kind == "absolute" and p and p.kind == "absolute" %}
                        let rect = crate::app::anchored(area, design, [{{ p.x }}, {{ p.y }}, {{ p.width }}, {{ p.height }}], [{{ p.anchors.left | lower }}, {{ p.anchors.top | lower }}, {{ p.anchors.right | lower }}, {{ p.anchors.bottom | lower }}]);
                        let response = ui.add_enabled_ui(self.{{ c.name }}.enabled, |ui| ui.put(rect, {{ item | indent(24) }})).inner;
                    {%- elif p and p.kind == "layout" and (p.width_percent > 0 or p.height_percent > 0) %}
                        // Prozent vom Inhalt des Containers (fehlende Achse wie bei der Wunschgröße).
                        let size = egui::vec2(
                            {% if p.width_percent > 0 %}full.x * {{ p.width_percent }} as f32 / 100.0{% elif p.width > 0 %}{{ p.width }} as f32{% else %}ui.available_width(){% endif %},
                            {% if p.height_percent > 0 %}full.y * {{ p.height_percent }} as f32 / 100.0{% elif p.height > 0 %}{{ p.height }} as f32{% else %}ui.spacing().interact_size.y{% endif %},
                        );
                        let response = ui.add_enabled_ui(self.{{ c.name }}.enabled, |ui| ui.add_sized(size, {{ item | indent(24) }})).inner;
                    {%- elif p and p.kind == "layout" and (p.width > 0 or p.height > 0) %}
                        // Wunschgröße aus dem Designer (fehlende Achse: Fill = verfügbare Breite, sonst Standardhöhe).
                        let size = egui::vec2(
                            {% if p.width > 0 %}{{ p.width }} as f32{% if l.kind in ["vertical", "custom"] and align == "Fill" %}.max(ui.available_width()){% endif %}{% else %}ui.available_width(){% endif %},
                            {% if p.height > 0 %}{{ p.height }} as f32{% else %}ui.spacing().interact_size.y{% endif %},
                        );
                        let response = ui.add_enabled_ui(self.{{ c.name }}.enabled, |ui| ui.add_sized(size, {{ item | indent(24) }})).inner;
                    {%- elif l.kind in ["vertical", "custom"] and align == "Fill" and c.type not in natural %}
                        let response = ui.with_layout(egui::Layout::top_down_justified(egui::Align::{{ "Center" if c.type == "core/Button" else "Min" }}), |ui| {
                            ui.add_enabled_ui(self.{{ c.name }}.enabled, |ui| ui.add({{ item | indent(28) }})).inner
                        }).inner;
                    {%- elif l.kind in ["vertical", "custom"] and align in ["Center", "End"] %}
                        let response = ui.with_layout(egui::Layout::top_down(egui::Align::{{ "Center" if align == "Center" else "Max" }}), |ui| {
                            ui.add_enabled_ui(self.{{ c.name }}.enabled, |ui| ui.add({{ item | indent(28) }})).inner
                        }).inner;
                    {%- else %}
                        let response = ui.add_enabled_ui(self.{{ c.name }}.enabled, |ui| ui.add({{ item | indent(24) }})).inner;
                    {%- endif %}
                        {{ events(c, radios) | indent(24) }}
                    }
                {%- if l.kind == "grid" %}
                    if {{ loop.index }} % {{ l.columns or 1 }} == 0 {
                        ui.end_row();
                    }
                {%- endif %}
            {%- endfor %}
            {%- if l.kind != "absolute" %}
                });
            {%- endif %}
            });
    {%- endif %}
    }
{%- endfor %}
}
{%- endif %}
