{%- if pictures %}

/// Pictures prepared for the page, served by the scheme `freya`.
static FREYA_PICTURES: std::sync::Mutex<
    std::collections::BTreeMap<String, std::sync::Arc<Vec<u8>>>,
> = std::sync::Mutex::new(std::collections::BTreeMap::new());

/// Address of a picture for the page, prepared by `freya_image` (gamma,
/// opacity) as a PNG; empty when it cannot be read.
pub fn freya_picture_url(path: &str, gamma: f64, opacity: f64) -> String {
    use std::hash::{Hash as _, Hasher as _};
    if path.is_empty() {
        return String::new();
    }
    let mut hasher = std::collections::hash_map::DefaultHasher::new();
    (path, gamma.to_bits(), opacity.to_bits()).hash(&mut hasher);
    let key = format!("{:016x}.png", hasher.finish());
    let mut pictures = FREYA_PICTURES
        .lock()
        .unwrap_or_else(std::sync::PoisonError::into_inner);
    if !pictures.contains_key(&key) {
        match freya_image(path, gamma, opacity).and_then(|image| freya_image_png(&image)) {
            Ok(png) => {
                pictures.insert(key.clone(), std::sync::Arc::new(png));
            }
            Err(error) => {
                eprintln!("{error}");
                return String::new();
            }
        }
    }
    // Windows (WebView2) reaches custom schemes via http://<scheme>.localhost.
    if cfg!(windows) {
        format!("http://freya.localhost/{key}")
    } else {
        format!("freya://localhost/{key}")
    }
}

/// Answers the page's request for a picture (scheme `freya`).
pub fn freya_picture_response(
    request: wry::http::Request<Vec<u8>>,
) -> wry::http::Response<std::borrow::Cow<'static, [u8]>> {
    let key = request.uri().path().trim_start_matches('/').to_owned();
    let png = FREYA_PICTURES
        .lock()
        .unwrap_or_else(std::sync::PoisonError::into_inner)
        .get(&key)
        .cloned();
    let builder = wry::http::Response::builder().header("Access-Control-Allow-Origin", "*");
    match png {
        Some(png) => builder
            .header("Content-Type", "image/png")
            .body(std::borrow::Cow::Owned(png.to_vec())),
        None => builder.status(404).body(std::borrow::Cow::Borrowed(&[][..])),
    }
    .unwrap_or_else(|_| wry::http::Response::new(std::borrow::Cow::Borrowed(&[][..])))
}

/// State of an ImageBox; `set_file` prepares another picture.
#[allow(dead_code)]
pub struct Picture {
    pub file: String,
    pub gamma: f64,
    pub opacity: f64,
    url: String,
}

#[allow(dead_code)]
impl Picture {
    pub fn new(file: &str, gamma: f64, opacity: f64) -> Self {
        let mut picture = Self {
            file: String::new(),
            gamma,
            opacity,
            url: String::new(),
        };
        picture.set_file(file);
        picture
    }

    pub fn set_file(&mut self, file: &str) {
        self.file = file.to_owned();
        self.url = freya_picture_url(file, self.gamma, self.opacity);
    }
}

impl FreyaValue for Picture {
    fn put(&self, control: &mut serde_json::Map<String, serde_json::Value>) {
        control.insert("text".into(), self.url.clone().into());
    }
}

/// State of an ImageScrollBox; the paths are the control's `items`,
/// `load` prepares their pictures.
#[allow(dead_code)]
pub struct Gallery {
    pub selected: Option<usize>,
    pub gamma: f64,
    pub opacity: f64,
    urls: Vec<String>,
}

#[allow(dead_code)]
impl Gallery {
    pub fn new(gamma: f64, opacity: f64) -> Self {
        Self {
            selected: None,
            gamma,
            opacity,
            urls: Vec::new(),
        }
    }

    /// Prepares the pictures of `paths`; the selection starts over.
    pub fn load(&mut self, paths: &[String]) {
        self.selected = None;
        self.urls = paths
            .iter()
            .map(|path| freya_picture_url(path, self.gamma, self.opacity))
            .collect();
    }

    /// Same as `load`, for the initial state.
    pub fn loaded(mut self, paths: &[&str]) -> Self {
        self.load(&paths.iter().map(|p| p.to_string()).collect::<Vec<_>>());
        self
    }
}

impl FreyaValue for Gallery {
    fn put(&self, control: &mut serde_json::Map<String, serde_json::Value>) {
        control.insert("items".into(), self.urls.clone().into());
        control.insert(
            "index".into(),
            self.selected.map_or(-1, |i| i as i64).into(),
        );
    }
    fn take(&mut self, input: &Input) {
        if let Some(index) = input.index {
            self.selected = usize::try_from(index).ok().filter(|i| *i < self.urls.len());
        }
    }
}
