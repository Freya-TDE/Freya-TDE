[data-kind="menubar"] details > div { position: absolute; z-index: 10; min-width: 12em; display: flex; flex-direction: column;
  background: Canvas; border: 1px solid color-mix(in srgb, currentColor 30%, transparent); padding: 4px 0; }
[data-kind="menubar"] details > div > button { text-align: left; border: 0; background: none; padding: 4px 14px; margin: 0;
  display: flex; justify-content: space-between; gap: 2em; width: 100%; color: inherit; }
[data-kind="menubar"] details > div > button:hover { background: Highlight; color: HighlightText; }
[data-kind="menubar"] details > div > hr { margin: 4px 0; }
[data-kind="menubar"], [data-kind="tabs"] > nav { justify-content: flex-start; align-items: stretch; }
[data-kind="menubar"] summary::after { display: none !important; }
