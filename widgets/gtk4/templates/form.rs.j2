{#- GTK 4: layout and events of a form, appended to <form>.gen.rs.
    Containers get an inner layout widget (Box, Grid, Stack or Fixed) built
    from the designer's layout; events call the handlers in <form>.rs. -#}
{%- set containers = ["core/Form", "core/Container", "backend:gtk4/Frame"] %}
{#- Wie die Theme-Tabelle des Designers (designer/themes/linux.toml): Rand 12, Abstand 8. -#}
{%- set default_layout = {"kind": "vertical", "spacing": 8, "padding": {"left": 12, "top": 12, "right": 12, "bottom": 12}} %}
{%- set menus = components | selectattr("type", "eq", "backend:gtk4/MainMenu") | selectattr("field") | list %}
{%- if root %}
#[allow(unused_imports)]
use gtk4::prelude::*;

impl {{ form.struct }} {
    /// Puts the widgets into their containers, as laid out in the designer.
    fn build_ui(&self) {
    {%- for w in widgets if w.field and w.type in containers %}
        {%- set l = w.layout or default_layout %}
        {
            {%- if l.kind == "horizontal" %}
            let layout = gtk4::Box::new(gtk4::Orientation::Horizontal, {{ l.spacing }});
            {%- elif l.kind == "grid" %}
            let layout = gtk4::Grid::new();
            layout.set_row_spacing({{ l.spacing }});
            layout.set_column_spacing({{ l.spacing }});
            {%- elif l.kind == "stack" %}
            let layout = gtk4::Stack::new();
            {%- elif l.kind == "absolute" %}
            // Absolut: ein Overlay legt jedes Kind nach seinen Ankern an
            // (Abstand zu den verankerten Rändern der Entwurfsfläche bleibt).
            let layout = gtk4::Overlay::new();
            {%- set ext = namespace(w=0, h=0) %}
            {%- for c in w.children if c.placement and c.placement.kind == "absolute" %}
            {%- set ext.w = [ext.w, c.placement.x + c.placement.width] | max %}
            {%- set ext.h = [ext.h, c.placement.y + c.placement.height] | max %}
            {%- endfor %}
            let base = gtk4::Box::new(gtk4::Orientation::Vertical, 0);
            base.set_size_request({{ ext.w }}, {{ ext.h }});
            layout.set_child(Some(&base));
            #[allow(unused_mut)]
            let mut places: Vec<(gtk4::Widget, [i32; 4], [bool; 4])> = Vec::new();
            {%- else %}
            let layout = gtk4::Box::new(gtk4::Orientation::Vertical, {{ l.spacing }});
            {%- endif %}
            layout.set_margin_start({{ l.padding.left }});
            layout.set_margin_top({{ l.padding.top }});
            layout.set_margin_end({{ l.padding.right }});
            layout.set_margin_bottom({{ l.padding.bottom }});
            {%- set radios = w.children | selectattr("type", "eq", "backend:gtk4/RadioButton") | selectattr("field") | list %}
            {%- for c in w.children if c.field %}
            {
                {%- if c.type in ["backend:gtk4/TextView", "backend:gtk4/DataGrid"] %}
                let scrolled = gtk4::ScrolledWindow::new();
                scrolled.set_child(Some(&self.{{ c.name }}));
                scrolled.set_min_content_height({{ 160 if c.type == "backend:gtk4/DataGrid" else 80 }});
                let child: gtk4::Widget = scrolled.upcast();
                {%- else %}
                let child: gtk4::Widget = self.{{ c.name }}.clone().upcast();
                {%- endif %}
                {%- set p = c.placement %}
                {%- if l.kind == "absolute" %}
                layout.add_overlay(&child);
                {%- if p and p.kind == "absolute" %}
                places.push((child, [{{ p.x }}, {{ p.y }}, {{ p.width }}, {{ p.height }}], [{{ p.anchors.left | lower }}, {{ p.anchors.top | lower }}, {{ p.anchors.right | lower }}, {{ p.anchors.bottom | lower }}]));
                {%- else %}
                places.push((child, [0, 0, 0, 0], [true, true, false, false]));
                {%- endif %}
                {%- elif l.kind == "stack" %}
                layout.add_child(&child);
                {%- else %}
                {%- set wp = p.width_percent if p and p.kind == "layout" else 0 %}
                {%- set hp = p.height_percent if p and p.kind == "layout" else 0 %}
                {%- set rw = p.width if p and p.kind == "layout" and p.width > 0 and wp == 0 else -1 %}
                {%- set rh = p.height if p and p.kind == "layout" and p.height > 0 and hp == 0 else -1 %}
                {%- if rw > 0 or rh > 0 %}
                // Wunschgröße aus dem Designer (-1 = natürlich).
                child.set_size_request({{ rw }}, {{ rh }});
                {%- endif %}
                {%- if wp > 0 or hp > 0 %}
                // Prozent vom Inhalt des Elternelements (0 = Achse natürlich).
                let child: gtk4::Widget = freya_percent::Percent::new(&child, {{ wp }}, {{ hp }}).upcast();
                {%- endif %}
                {%- set align = p.align if p and p.kind == "layout" else "Fill" %}
                {%- if (wp > 0 or hp > 0) and align == "Fill" %}{% set align = "Start" %}{% endif %}
                {%- set main_pct = wp if l.kind == "horizontal" else hp %}
                {%- set stretch = "true" if (p.stretch if p and p.kind == "layout" else 0) > 0 and main_pct == 0 else "false" %}
                {%- if l.kind == "horizontal" %}
                {%- if align != "Fill" %}
                child.set_valign(gtk4::Align::{{ align }});
                {%- endif %}
                child.set_hexpand({{ stretch }});
                layout.append(&child);
                {%- elif l.kind == "grid" %}
                {%- if align != "Fill" %}
                child.set_halign(gtk4::Align::{{ align }});
                {%- endif %}
                {%- if align != "Fill" %}
                child.set_valign(gtk4::Align::{{ align }});
                {%- endif %}
                child.set_hexpand({{ stretch }});
                {%- set columns = l.columns or 1 %}
                {%- if p and p.cell %}
                layout.attach(&child, {{ p.cell.column }} as i32, {{ p.cell.row }} as i32, {{ p.cell.column_span }} as i32, {{ p.cell.row_span }} as i32);
                {%- else %}
                layout.attach(&child, {{ loop.index0 % columns }}, {{ loop.index0 // columns }}, 1, 1);
                {%- endif %}
                {%- else %}
                {%- if align != "Fill" %}
                child.set_halign(gtk4::Align::{{ align }});
                {%- endif %}
                child.set_vexpand({{ stretch }});
                layout.append(&child);
                {%- endif %}
                {%- endif %}
            }
            {%- if c.type == "backend:gtk4/RadioButton" and radios and c.name != radios[0].name %}
            self.{{ c.name }}.set_group(Some(&self.{{ radios[0].name }}));
            {%- endif %}
            {%- endfor %}
            {%- if l.kind == "absolute" %}
            {%- set area = (w.children | selectattr("placement") | selectattr("placement.kind", "eq", "absolute") | first) %}
            {%- if area %}
            let (design_w, design_h) = ({{ area.placement.area.width }}, {{ area.placement.area.height }});
            {%- else %}
            let (design_w, design_h) = ({{ ext.w }}, {{ ext.h }});
            {%- endif %}
            layout.connect_get_child_position(move |overlay, widget| {
                let (_, [x, y, w, h], [left, top, right, bottom]) =
                    places.iter().find(|(c, _, _)| c == widget)?;
                let (w, h) = if *w > 0 {
                    (*w, *h)
                } else {
                    let natural = widget.preferred_size().1;
                    (natural.width(), natural.height())
                };
                // Wie Delphis Anchors: links und rechts = wächst mit, nur rechts = wandert mit.
                let axis = |start: bool, end: bool, pos: i32, len: i32, delta: i32| match (start, end) {
                    (true, true) => (pos, (len + delta).max(0)),
                    (false, true) => (pos + delta, len),
                    (false, false) => (pos + delta / 2, len),
                    (true, false) => (pos, len),
                };
                let (x, w) = axis(*left, *right, *x, w, overlay.width() - design_w);
                let (y, h) = axis(*top, *bottom, *y, h, overlay.height() - design_h);
                Some(gtk4::gdk::Rectangle::new(x, y, w, h))
            });
            {%- endif %}
            {%- if w.type == "core/Container" %}
            layout.set_hexpand(true);
            layout.set_vexpand(true);
            self.{{ w.name }}.append(&layout);
            {%- elif w.type == "core/Form" and menus %}
            // Menüleiste über dem Inhalt.
            let outer = gtk4::Box::new(gtk4::Orientation::Vertical, 0);
            outer.append(&self.{{ menus[0].name }});
            layout.set_vexpand(true);
            outer.append(&layout);
            self.{{ w.name }}.set_child(Some(&outer));
            {%- else %}
            self.{{ w.name }}.set_child(Some(&layout));
            {%- endif %}
        }
    {%- endfor %}
    {%- for w in widgets if w.field and w.type == "backend:gtk4/Notebook" %}
        // Reiter: jedes Kind ist eine Seite, Titel aus `pages` (sonst der Name).
        {
            let titles: Vec<&str> = {{ w.rust.pages }};
            let title = |index: usize, name: &'static str| titles.get(index).copied().unwrap_or(name);
            let _ = &title;
            {%- for c in w.children if c.field %}
            self.{{ w.name }}.append_page(&self.{{ c.name }}, Some(&gtk4::Label::new(Some(title({{ loop.index0 }}, "{{ c.name }}")))));
            {%- endfor %}
            self.{{ w.name }}.set_current_page(Some({{ w.props.page }}));
        }
    {%- endfor %}
    }

    /// Colours, fonts and background pictures from the designer, as CSS
    /// (one class per widget; fonts and colours pass on to children).
    #[allow(unused_mut, deprecated)]
    fn freya_appearance(&self) {
        let mut css = String::new();
    {%- for w in widgets if w.field %}
        {%- set p = w.props %}
        {%- set cls = "freya-" ~ form.name ~ "-" ~ w.name %}
        {%- set rule = namespace(text="") %}
        {%- if p.background.a > 0 %}{% set rule.text = rule.text ~ "background-color: rgba(" ~ p.background.r ~ "," ~ p.background.g ~ "," ~ p.background.b ~ "," ~ (p.background.a / 255) ~ "); background-image: none; " %}{% endif %}
        {%- if p.foreground.a > 0 %}{% set rule.text = rule.text ~ "color: rgb(" ~ p.foreground.r ~ "," ~ p.foreground.g ~ "," ~ p.foreground.b ~ "); " %}{% endif %}
        {%- if p.font_size > 0 %}{% set rule.text = rule.text ~ "font-size: " ~ p.font_size ~ "px; " %}{% endif %}
        {%- if p.bold %}{% set rule.text = rule.text ~ "font-weight: bold; " %}{% endif %}
        {%- if p.italic %}{% set rule.text = rule.text ~ "font-style: italic; " %}{% endif %}
        {%- if p.font_family is defined and p.font_family %}{% set rule.text = rule.text ~ "font-family: \"" ~ p.font_family ~ "\"; " %}{% endif %}
        {%- set image = p.background_image is defined and p.background_image %}
        {%- if rule.text or image %}
        self.{{ w.name }}.add_css_class("{{ cls }}");
        {%- endif %}
        {%- if rule.text %}
        css.push_str({{ ("." ~ cls ~ " { " ~ rule.text ~ "}\n") | rust_str }});
        {%- endif %}
        {%- if image %}
        {
            let file = gtk4::gio::File::for_path(std::env::current_dir().unwrap_or_default().join({{ w.rust.background_image }}));
            css.push_str({{ ("." ~ cls ~ " { background-image: url(\"") | rust_str }});
            css.push_str(&file.uri());
            css.push_str({{ ("\"); background-repeat: no-repeat; background-position: center; background-size: " ~ {"Cover": "cover", "Stretch": "100% 100%", "Contain": "contain", "Center": "auto"}[p.background_fit] ~ "; }\n") | rust_str }});
        }
        {%- endif %}
    {%- endfor %}
        if css.is_empty() {
            return;
        }
        let provider = gtk4::CssProvider::new();
        provider.load_from_data(&css);
        if let Some(display) = gtk4::gdk::Display::default() {
            gtk4::style_context_add_provider_for_display(
                &display,
                &provider,
                gtk4::STYLE_PROVIDER_PRIORITY_APPLICATION,
            );
        }
    }

    /// Calls `f` with the form, unless it is gone or busy (a handler that
    /// changes a widget can trigger another event of the same form).
    #[allow(dead_code)]
    fn freya_call(
        form: &std::rc::Weak<std::cell::RefCell<Self>>,
        f: impl FnOnce(&mut Self),
    ) {
        if let Some(form) = form.upgrade() {
            if let Ok(mut form) = form.try_borrow_mut() {
                f(&mut form);
            }
        }
    }

    /// Builds the layout, connects the events and – for the main form –
    /// shows the window; closing the main form ends `main_loop`.
    pub fn start(
        this: &std::rc::Rc<std::cell::RefCell<Self>>,
        main_loop: Option<gtk4::glib::MainLoop>,
    ) {
        this.borrow().build_ui();
        this.borrow().freya_appearance();
        let form = this.borrow();
        let weak = std::rc::Rc::downgrade(this);
        let _ = &weak;
        // Fenster: Mindestgröße, Zustand, Hell/Dunkel (die Lage bestimmt unter
        // GTK 4 das System; eine Höchstgröße kennt GTK 4 nicht).
    {%- set rp = root.props %}
    {%- if rp.min_size.width > 0 or rp.min_size.height > 0 %}
        form.{{ root.name }}.set_size_request({{ rp.min_size.width }}, {{ rp.min_size.height }});
    {%- endif %}
    {%- if rp.start_state == "Maximized" %}
        form.{{ root.name }}.maximize();
    {%- elif rp.start_state == "Fullscreen" %}
        form.{{ root.name }}.fullscreen();
    {%- endif %}
    {%- if rp.theme != "System" %}
        if let Some(settings) = gtk4::Settings::default() {
            settings.set_gtk_application_prefer_dark_theme({{ "true" if rp.theme == "Dark" else "false" }});
        }
    {%- endif %}
    {%- for w in widgets if w.field %}
    {%- for event, handler in w.events | items if handler and w.type != "core/Form" %}
    {%- set key = w.type ~ "." ~ event %}
        {
            let weak = weak.clone();
        {%- if key in ["core/Button.on_click"] %}
            form.{{ w.name }}.connect_clicked(move |_| Self::freya_call(&weak, |f| f.{{ handler }}()));
        {%- elif key == "core/Edit.on_change" %}
            form.{{ w.name }}.connect_changed(move |edit| {
                let text = edit.text();
                Self::freya_call(&weak, |f| f.{{ handler }}(&text));
            });
        {%- elif key == "core/Edit.on_submit" %}
            form.{{ w.name }}.connect_activate(move |_| Self::freya_call(&weak, |f| f.{{ handler }}()));
        {%- elif key in ["core/CheckBox.on_toggle", "backend:gtk4/RadioButton.on_toggle"] %}
            form.{{ w.name }}.connect_toggled(move |check| {
                let checked = check.is_active();
                Self::freya_call(&weak, |f| f.{{ handler }}(checked));
            });
        {%- elif key == "backend:gtk4/Switch.on_toggle" %}
            form.{{ w.name }}.connect_active_notify(move |switch| {
                let active = switch.is_active();
                Self::freya_call(&weak, |f| f.{{ handler }}(active));
            });
        {%- elif key in ["backend:gtk4/SpinButton.on_change", "backend:gtk4/Scale.on_change"] %}
            form.{{ w.name }}.connect_value_changed(move |input| {
                let value = input.value();
                Self::freya_call(&weak, |f| f.{{ handler }}(value));
            });
        {%- elif key == "backend:gtk4/DropDown.on_select" %}
            form.{{ w.name }}.connect_selected_notify(move |dropdown| {
                let index = dropdown.selected();
                Self::freya_call(&weak, |f| f.{{ handler }}(index));
            });
        {%- elif key == "backend:gtk4/ListBox.on_select" %}
            form.{{ w.name }}.connect_row_selected(move |_, row| {
                let index = row.map_or(-1, |row| row.index());
                Self::freya_call(&weak, |f| f.{{ handler }}(index));
            });
        {%- elif key == "backend:gtk4/Notebook.on_page" %}
            form.{{ w.name }}.connect_switch_page(move |_, _, page| {
                Self::freya_call(&weak, |f| f.{{ handler }}(page));
            });
        {%- elif key == "backend:gtk4/DataGrid.on_select" %}
            // Das Modell kommt erst mit den Daten: bei jedem neuen Modell verbinden.
            form.{{ w.name }}.connect_model_notify(move |grid| {
                if let Some(model) = grid.model().and_downcast::<gtk4::SingleSelection>() {
                    let weak = weak.clone();
                    model.connect_selected_notify(move |model| {
                        let selected = model.selected();
                        let index = if selected == gtk4::INVALID_LIST_POSITION { -1 } else { selected as i32 };
                        Self::freya_call(&weak, |f| f.{{ handler }}(index));
                    });
                }
            });
        {%- elif key == "backend:gtk4/TextView.on_change" %}
            form.{{ w.name }}.buffer().connect_changed(move |buffer| {
                let text = buffer.text(&buffer.start_iter(), &buffer.end_iter(), false);
                Self::freya_call(&weak, |f| f.{{ handler }}(&text));
            });
        {%- endif %}
        }
    {%- endfor %}
    {%- endfor %}
    {%- for m in menus %}
        // Hauptmenü: eine Aktion je Eintrag (`{{ m.name }}.item<n>`), Kürzel am Fenster.
        {
            let group = gtk4::gio::SimpleActionGroup::new();
            let shortcuts = gtk4::ShortcutController::new();
            shortcuts.set_scope(gtk4::ShortcutScope::Global);
            let items: Vec<&str> = {{ m.rust.items }};
            for (index, entry) in items.iter().enumerate() {
                let (path, keys) = match entry.split_once('|') {
                    Some((path, keys)) => (path.trim(), keys.trim()),
                    None => (entry.trim(), ""),
                };
                if path.ends_with('-') || !path.contains('/') {
                    continue;
                }
                let action = gtk4::gio::SimpleAction::new(&format!("item{index}"), None);
                {%- if m.events.on_select %}
                {
                    let weak = weak.clone();
                    let path = path.to_owned();
                    action.connect_activate(move |_, _| {
                        Self::freya_call(&weak, |f| f.{{ m.events.on_select }}(&path));
                    });
                }
                {%- endif %}
                group.add_action(&action);
                if !keys.is_empty() {
                    // `Ctrl+Shift+S` → `<Control><Shift>s` (macOS: Befehlstaste).
                    let parts: Vec<&str> = keys.split('+').map(str::trim).collect();
                    let mut accel = String::new();
                    for (i, part) in parts.iter().enumerate() {
                        if i + 1 < parts.len() {
                            accel.push_str(match part.to_ascii_lowercase().as_str() {
                                "ctrl" | "strg" if cfg!(target_os = "macos") => "<Meta>",
                                "ctrl" | "strg" => "<Control>",
                                "shift" | "umschalt" => "<Shift>",
                                "alt" => "<Alt>",
                                _ => "<Meta>",
                            });
                        } else if part.chars().count() == 1 {
                            accel.push_str(&part.to_lowercase());
                        } else {
                            accel.push_str(part);
                        }
                    }
                    if let Some(trigger) = gtk4::ShortcutTrigger::parse_string(&accel) {
                        let target = gtk4::NamedAction::new(&format!("{{ m.name }}.item{index}"));
                        shortcuts.add_shortcut(gtk4::Shortcut::new(Some(trigger), Some(target)));
                    }
                }
            }
            form.{{ root.name }}.insert_action_group("{{ m.name }}", Some(&group));
            form.{{ root.name }}.add_controller(shortcuts);
        }
    {%- endfor %}
        // Schließen: `on_close` darf es verhindern; das Hauptformular beendet
        // das Programm.
        {
        {%- if root.events.on_close %}
            let weak = weak.clone();
        {%- endif %}
            form.{{ root.name }}.connect_close_request(move |_| {
                #[allow(unused_mut)]
                let mut close = true;
            {%- if root.events.on_close %}
                Self::freya_call(&weak, |f| close = f.{{ root.events.on_close }}());
            {%- endif %}
                if !close {
                    return gtk4::glib::Propagation::Stop;
                }
                if let Some(main_loop) = &main_loop {
                    main_loop.quit();
                }
                gtk4::glib::Propagation::Proceed
            });
        }
        drop(form);
        // Daten der Listen: beim Öffnen laden, Ergebnisse alle 100 ms übernehmen.
        this.borrow().freya_start_data();
    {%- if data_bound %}
        {
            let weak = weak.clone();
            gtk4::glib::timeout_add_local(std::time::Duration::from_millis(100), move || {
                let Some(form) = weak.upgrade() else {
                    return gtk4::glib::ControlFlow::Break;
                };
                if let Ok(mut form) = form.try_borrow_mut() {
                    form.freya_take_data();
                }
                gtk4::glib::ControlFlow::Continue
            });
        }
    {%- endif %}
    {%- if root.events.on_create %}
        Self::freya_call(&weak, |f| f.{{ root.events.on_create }}());
    {%- endif %}
    }

    /// Shows the form's window.
    #[allow(dead_code)]
    pub fn show(&self) {
        self.{{ root.name }}.present();
    }
}
{%- set percent = namespace(any=false) %}
{%- for w in widgets if w.placement and w.placement.kind == "layout" and (w.placement.width_percent > 0 or w.placement.height_percent > 0) %}{% set percent.any = true %}{% endfor %}
{%- if percent.any %}

/// A widget sized in percent of its parent's content (GTK has no
/// percentages): its natural size on such an axis is that share; the
/// minimum stays the child's, so the window can still shrink.
mod freya_percent {
    use gtk4::glib;
    use gtk4::prelude::*;
    use gtk4::subclass::prelude::*;

    mod imp {
        use super::*;
        use std::cell::Cell;

        #[derive(Default)]
        pub struct Percent {
            pub percent: Cell<(i32, i32)>,
            /// Parent size the last measurement used.
            pub seen: Cell<(i32, i32)>,
        }

        #[glib::object_subclass]
        impl ObjectSubclass for Percent {
            const NAME: &'static str = "FreyaPercent{{ form.struct }}";
            type Type = super::Percent;
            type ParentType = gtk4::Widget;
        }

        impl ObjectImpl for Percent {
            fn dispose(&self) {
                while let Some(child) = self.obj().first_child() {
                    child.unparent();
                }
            }
        }

        impl WidgetImpl for Percent {
            fn measure(&self, orientation: gtk4::Orientation, for_size: i32) -> (i32, i32, i32, i32) {
                let obj = self.obj();
                let Some(child) = obj.first_child() else {
                    return (0, 0, -1, -1);
                };
                let (min, natural, _, _) = child.measure(orientation, for_size);
                let parent = WidgetExt::parent(&*obj).map_or((0, 0), |p| (p.width(), p.height()));
                self.seen.set(parent);
                let (wp, hp) = self.percent.get();
                let (percent, space) = match orientation {
                    gtk4::Orientation::Horizontal => (wp, parent.0),
                    _ => (hp, parent.1),
                };
                let natural = if percent > 0 { (space * percent / 100).max(min) } else { natural };
                (min, natural, -1, -1)
            }

            fn size_allocate(&self, width: i32, height: i32, baseline: i32) {
                let obj = self.obj();
                if let Some(child) = obj.first_child() {
                    child.allocate(width, height, baseline, None);
                }
                // Neue Größe des Elternelements: neu messen (nach dieser Runde).
                let parent = WidgetExt::parent(&*obj).map_or((0, 0), |p| (p.width(), p.height()));
                if parent != self.seen.get() {
                    let weak = obj.downgrade();
                    glib::idle_add_local_once(move || {
                        if let Some(obj) = weak.upgrade() {
                            obj.queue_resize();
                        }
                    });
                }
            }
        }
    }

    glib::wrapper! {
        pub struct Percent(ObjectSubclass<imp::Percent>)
            @extends gtk4::Widget,
            @implements gtk4::Buildable, gtk4::ConstraintTarget;
    }

    impl Percent {
        pub fn new(child: &impl IsA<gtk4::Widget>, width: i32, height: i32) -> Self {
            let this: Self = glib::Object::new();
            this.imp().percent.set((width, height));
            child.set_parent(&this);
            this
        }
    }
}
