impl crate::app::FreyaUpdate for {{ form.struct }} {
    type Message = Message;

    /// Applies `message` to the state and calls the handler.
    #[allow(unused_variables)]
    fn update(&mut self, message: Message) {
        match message {
        {%- if data_bound %}
            Message::freya_data => {
                self.freya_take_data();
            }
        {%- endif %}
        {%- for m in menus %}
            Message::{{ m.name }}_open(index) => {
                self.{{ m.name }}.value = index;
            }
            Message::{{ m.name }}_choose(item) => {
                self.{{ m.name }}.value = None;
            {%- if m.events.on_select %}
                self.{{ m.events.on_select }}(&item);
            {%- endif %}
            }
        {%- endfor %}
        {%- for m in cmenus %}
            Message::{{ m.name }}_choose(item) => {
            {%- if m.events.on_select %}
                self.{{ m.events.on_select }}(&item);
            {%- endif %}
            }
        {%- endfor %}
        {%- for c in widgets if c.field %}
        {%- set t = c.type %}
        {%- set e = c.events %}
        {%- if t == p_ ~ "Calendar" %}
            Message::{{ c.name }}_select(year, month, day) => {
                if self.{{ c.name }}.enabled {
                    self.{{ c.name }}.value.selected = Some((year, month, day));
                    self.{{ c.name }}.value.view = (year, month);
                {%- if e.on_select %}
                    self.{{ e.on_select }}(year, month, day);
                {%- endif %}
                }
            }
            Message::{{ c.name }}_month(year, month) => {
                self.{{ c.name }}.value.view = (year, month);
            }
        {%- elif t == p_ ~ "ColorPicker" %}
            Message::{{ c.name }}_change(color) => {
                if self.{{ c.name }}.enabled {
                    self.{{ c.name }}.value = color;
                {%- if e.on_change %}
                    self.{{ e.on_change }}(color);
                {%- endif %}
                }
            }
        {%- elif t == p_ ~ "Popup" %}
            Message::{{ c.name }}_close => {
            {%- if e.on_close %}
                if self.{{ e.on_close }}() {
                    self.{{ c.name }}.value = false;
                }
            {%- else %}
                self.{{ c.name }}.value = false;
            {%- endif %}
            }
        {%- elif t == p_ ~ "CodeEditor" %}
            Message::{{ c.name }}_input(text) => {
                self.{{ c.name }}.value = text;
            {%- if e.on_change %}
                let text = self.{{ c.name }}.value.clone();
                self.{{ e.on_change }}(&text);
            {%- endif %}
            }
        {%- elif t == p_ ~ "Terminal" %}
            Message::{{ c.name }}_exit => {
            {%- if e.on_exit %}
                self.{{ e.on_exit }}();
            {%- endif %}
            }
        {%- elif t == p_ ~ "Video" %}
            Message::{{ c.name }}_playing(playing) => {
                self.{{ c.name }}.value.playing = playing;
            }
        {%- elif t == p_ ~ "DropZone" %}
            Message::{{ c.name }}_drop(data) => {
            {%- if e.on_drop %}
                self.{{ e.on_drop }}(&data);
            {%- endif %}
            }
        {%- elif t in [p_ ~ "SegmentedButton", p_ ~ "SideBar"] %}
            Message::{{ c.name }}_select(index) => {
                if self.{{ c.name }}.enabled {
                    self.{{ c.name }}.value = index;
                {%- if e.on_select %}
                    self.{{ e.on_select }}(index as u32);
                {%- endif %}
                }
            }
        {%- elif t == p_ ~ "VirtualList" %}
            Message::{{ c.name }}_select(index) => {
                self.{{ c.name }}.value = index as i32;
            {%- if e.on_select %}
                self.{{ e.on_select }}(index as i32);
            {%- endif %}
            }
        {%- elif t == "core/ImageBox" %}
            Message::{{ c.name }}_click => {
            {%- if e.on_click %}
                self.{{ e.on_click }}();
            {%- endif %}
            }
        {%- elif t == "core/ImageScrollBox" %}
            Message::{{ c.name }}_pick(index) => {
                self.{{ c.name }}.value.selected = Some(index);
            {%- if e.on_select %}
                let path = self.{{ c.name }}.items.get(index).cloned().unwrap_or_default();
                self.{{ e.on_select }}(index, &path);
            {%- endif %}
            }
        {%- elif t == "core/Button" %}
            Message::{{ c.name }}_click => {
            {%- if e.on_click %}
                if self.{{ c.name }}.enabled {
                    self.{{ e.on_click }}();
                }
            {%- endif %}
            }
        {%- elif t == "core/Edit" %}
            Message::{{ c.name }}_input(text) => {
            {%- if c.props.max_length > 0 %}
                self.{{ c.name }}.value = text.chars().take({{ c.props.max_length }}).collect();
            {%- else %}
                self.{{ c.name }}.value = text;
            {%- endif %}
            {%- if e.on_change %}
                let text = self.{{ c.name }}.value.clone();
                self.{{ e.on_change }}(&text);
            {%- endif %}
            }
            Message::{{ c.name }}_submit => {
            {%- if e.on_submit %}
                self.{{ e.on_submit }}();
            {%- endif %}
            }
        {%- elif t in ["core/CheckBox", p_ ~ "Switch", p_ ~ "Chip"] %}
            Message::{{ c.name }}_toggle(checked) => {
                if self.{{ c.name }}.enabled {
                    self.{{ c.name }}.value = checked;
                {%- if e.on_toggle %}
                    self.{{ e.on_toggle }}(checked);
                {%- endif %}
                }
            }
        {%- elif t == p_ ~ "Slider" %}
            Message::{{ c.name }}_change(value) => {
                if self.{{ c.name }}.enabled {
                    let step: f64 = {{ c.rust.step }};
                    let value = if step > 0.0 { ((value - {{ c.rust.minimum }}) / step).round() * step + {{ c.rust.minimum }} } else { value };
                    let value = value.clamp({{ c.rust.minimum }}, {{ c.rust.maximum }});
                    if value != self.{{ c.name }}.value {
                        self.{{ c.name }}.value = value;
                    {%- if e.on_change %}
                        self.{{ e.on_change }}(value);
                    {%- endif %}
                    }
                }
            }
        {%- elif t == p_ ~ "Select" %}
            Message::{{ c.name }}_select(index) => {
                if self.{{ c.name }}.enabled {
                    self.{{ c.name }}.value = index;
                {%- if e.on_select %}
                    self.{{ e.on_select }}(index as u32);
                {%- endif %}
                }
            }
        {%- elif t == p_ ~ "ListBox" %}
            Message::{{ c.name }}_select(index) => {
                self.{{ c.name }}.value = index as i32;
            {%- if e.on_select %}
                self.{{ e.on_select }}(index as i32);
            {%- endif %}
            }
        {%- elif t == p_ ~ "DataGrid" %}
        {%- set editable = c.props.editable and c.props.data_source %}
            Message::{{ c.name }}_select(index) => {
            {%- if editable %}
                // Eine bearbeitete Zelle übernehmen, dann speichert der Zeilenwechsel.
                if let Some((row, column, text)) = self.{{ c.name }}.value.editing.take() {
                    let _ = self.{{ c.name }}_edit_cell(row, column, &text);
                }
            {%- endif %}
                self.{{ c.name }}.value.selected = Some(index);
            {%- if editable %}
                self.{{ c.name }}_row_changed(Some(index));
            {%- endif %}
            {%- if e.on_select %}
                self.{{ e.on_select }}(index as i32);
            {%- endif %}
            }
        {%- if editable %}
            Message::{{ c.name }}_edit_start(index, column) => {
                if let Some((row, column, text)) = self.{{ c.name }}.value.editing.take() {
                    let _ = self.{{ c.name }}_edit_cell(row, column, &text);
                }
                let text = self
                    .{{ c.name }}
                    .value
                    .rows
                    .get(index)
                    .and_then(|r| r.get(column))
                    .cloned()
                    .unwrap_or_default();
                self.{{ c.name }}.value.editing = Some((index, column, text));
            }
            Message::{{ c.name }}_edit_input(text) => {
                if let Some(cell) = self.{{ c.name }}.value.editing.as_mut() {
                    cell.2 = text;
                }
            }
            Message::{{ c.name }}_edit_submit => {
                if let Some((row, column, text)) = self.{{ c.name }}.value.editing.take() {
                    if let Some(cell) = self.{{ c.name }}.value.rows.get_mut(row).and_then(|r| r.get_mut(column)) {
                        *cell = text.clone();
                    }
                    let _ = self.{{ c.name }}_edit_cell(row, column, &text);
                }
                self.{{ c.name }}_post();
            }
        {%- endif %}
        {%- elif t == p_ ~ "TextEdit" %}
            Message::{{ c.name }}_input(text) => {
                if self.{{ c.name }}.enabled {
                    self.{{ c.name }}.value = text;
                {%- if e.on_change %}
                    let text = self.{{ c.name }}.value.clone();
                    self.{{ e.on_change }}(&text);
                {%- endif %}
                }
            }
        {%- elif t == p_ ~ "Tabs" %}
            Message::{{ c.name }}_page(page) => {
                self.{{ c.name }}.value = page;
            {%- if e.on_page %}
                self.{{ e.on_page }}(page as u32);
            {%- endif %}
            }
        {%- endif %}
        {%- endfor %}
        {#- Optionsfelder: das gewählte an, die übrigen im selben Container aus. #}
        {%- for w in widgets if w.field and w.type in containers %}
        {%- set radios = w.children | selectattr("type", "eq", p_ ~ "RadioButton") | selectattr("field") | list %}
        {%- for c in radios %}
            Message::{{ c.name }}_select => {
                if self.{{ c.name }}.enabled {
                    self.{{ c.name }}.value = true;
                {%- for o in radios if o.name != c.name %}
                    self.{{ o.name }}.value = false;
                {%- endfor %}
                {%- if c.events.on_toggle %}
                    self.{{ c.events.on_toggle }}(true);
                {%- endif %}
                }
            }
        {%- endfor %}
        {%- endfor %}
        }
    }
}

impl {{ form.struct }} {
    /// Called once before the window opens.
    pub fn freya_created(&mut self) {
        // Daten der Listen laden (im Hintergrund).
        self.freya_start_data();
    {%- if root.events.on_create %}
        self.{{ root.events.on_create }}();
    {%- endif %}
    }

    /// The window of the form with the settings from the designer.
    pub fn freya_window(form: std::rc::Rc<std::cell::RefCell<Self>>) -> freya::prelude::WindowConfig {
        {%- set rp = root.props %}
        {%- if root.events.on_close %}
        let closing = form.clone();
        {%- endif %}
        let title = form.borrow().{{ root.name }}.caption.clone();
        freya::prelude::WindowConfig::new_app(crate::app::FreyaRoot(form))
            .with_size({{ rp.size.width }} as f64, {{ rp.size.height }} as f64)
            .with_resizable({{ root.rust.resizable }})
        {%- if rp.min_size.width > 0 or rp.min_size.height > 0 %}
            .with_min_size({{ rp.min_size.width }} as f64, {{ rp.min_size.height }} as f64)
        {%- endif %}
        {%- if rp.max_size.width > 0 or rp.max_size.height > 0 %}
            .with_max_size({{ rp.max_size.width if rp.max_size.width > 0 else 100000 }} as f64, {{ rp.max_size.height if rp.max_size.height > 0 else 100000 }} as f64)
        {%- endif %}
            .with_window_attributes(move |attributes, _| {
                let attributes = attributes.with_title(title);
            {%- if rp.position == "Manual" %}
                let attributes = attributes.with_position(freya::winit::dpi::LogicalPosition::new({{ rp.location.x }} as f64, {{ rp.location.y }} as f64));
            {%- endif %}
            {%- if rp.start_state == "Maximized" %}
                let attributes = attributes.with_maximized(true);
            {%- elif rp.start_state == "Fullscreen" %}
                let attributes = attributes.with_fullscreen(Some(freya::winit::window::Fullscreen::Borderless(None)));
            {%- endif %}
                attributes
            })
        {%- if root.events.on_close %}
            .with_on_close(move |_, _| {
                if closing.borrow_mut().{{ root.events.on_close }}() {
                    freya::prelude::CloseDecision::Close
                } else {
                    freya::prelude::CloseDecision::KeepOpen
                }
            })
        {%- endif %}
    }
}

/// The view of form `{{ form.name }}` with freya's elements.
#[allow(unused_imports, clippy::all)]
mod freya_ui {
    use freya::prelude::*;
    use super::{{ "{" }}{{ form.struct }}, Message{{ "}" }};

    type Sender = crate::app::FreyaSender<{{ form.struct }}>;

    impl crate::app::FreyaView for {{ form.struct }} {
        const THEME: &'static str = "{{ root.props.theme }}";

        fn freya_title(&self) -> String {
            self.{{ root.name }}.caption.clone()
        }
        {%- if data_bound %}

        /// Wakes the window when rows of a list arrived (data binding).
        fn freya_watch(sender: &Sender) {
            use futures_util::StreamExt as _;
            let (wake, mut woken) = futures_channel::mpsc::unbounded::<()>();
            // Einmal sofort: schon fertige Ladevorgänge übernehmen.
            let _ = wake.unbounded_send(());
            crate::app::freya_set_waker(move || {
                let _ = wake.unbounded_send(());
            });
            let sender = sender.clone();
            spawn(async move {
                while woken.next().await.is_some() {
                    sender.send(Message::freya_data);
                }
            });
        }
        {%- endif %}

        fn freya_view(&self, s: &Sender) -> Element {
            {%- set rp = root.props %}
