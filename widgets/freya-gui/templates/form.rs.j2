    {{ c.name }}_playing(bool),
{%- elif t == p_ ~ "RadioButton" %}
    {{ c.name }}_select,
{%- elif t == p_ ~ "Slider" %}
    {{ c.name }}_change(f64),
{%- elif t in [p_ ~ "Select", p_ ~ "ListBox", p_ ~ "DataGrid", p_ ~ "SegmentedButton", p_ ~ "SideBar", p_ ~ "VirtualList"] %}
    {{ c.name }}_select(usize),
{%- if t == p_ ~ "DataGrid" and c.props.editable and c.props.data_source %}
    {{ c.name }}_edit_start(usize, usize),
