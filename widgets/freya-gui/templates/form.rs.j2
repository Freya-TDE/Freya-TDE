{%- elif t in ["core/CheckBox", p_ ~ "Switch", p_ ~ "Chip"] %}
    {{ c.name }}_toggle(bool),
{%- elif t == p_ ~ "Calendar" %}
    {{ c.name }}_select(i32, u32, u32),
    {{ c.name }}_month(i32, u32),
{%- elif t == p_ ~ "ColorPicker" %}
    {{ c.name }}_change(freya::prelude::Color),
{%- elif t == p_ ~ "Popup" %}
    {{ c.name }}_close,
{%- elif t == p_ ~ "DropZone" %}
    {{ c.name }}_drop(String),
{%- elif t == p_ ~ "CodeEditor" %}
    {{ c.name }}_input(String),
{%- elif t == p_ ~ "Terminal" %}
    {{ c.name }}_exit,
