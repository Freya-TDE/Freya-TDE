{#- freya: the form as a reactive freya window (appended to <form>.gen.rs).
    freya (https://freyaui.dev) is an independent project by Marc Espín; Freya TDE
    only supports it.
    Every input is a `Message`; `update` changes the state and calls the
    handlers in <form>.rs; the view is built in the module `freya_ui` (freya's
    prelude stays there), one method `freya_view_<name>` per container. -#}
{%- set p_ = "backend:freya-gui/" %}
{%- set containers = ["core/Form", "core/Container", p_ ~ "Card", p_ ~ "Tabs", p_ ~ "Accordion", p_ ~ "Skeleton", p_ ~ "Splitter", p_ ~ "DragCanvas", p_ ~ "Popup", p_ ~ "DragZone", p_ ~ "DropZone", p_ ~ "Lazy", p_ ~ "DockArea"] %}
{#- Widgets that keep their natural width even with align Fill. -#}
{%- set natural = ["core/Label", "core/CheckBox", p_ ~ "RadioButton", p_ ~ "Switch", p_ ~ "Link"] %}
{#- Wie die Theme-Tabelle des Designers (designer/themes/linux.toml): Rand 12, Abstand 8. -#}
{%- set default_layout = {"kind": "vertical", "spacing": 8, "padding": {"left": 12, "top": 12, "right": 12, "bottom": 12}} %}
{%- set menus = components | selectattr("type", "eq", p_ ~ "MainMenu") | selectattr("field") | list %}
{#- tree-sitter grammar and highlight query per CodeEditor language. -#}
{%- set languages = {"Rust": "tree_sitter_rust::LANGUAGE, tree_sitter_rust::HIGHLIGHTS_QUERY", "Python": "tree_sitter_python::LANGUAGE, tree_sitter_python::HIGHLIGHTS_QUERY", "JavaScript": "tree_sitter_javascript::LANGUAGE, tree_sitter_javascript::HIGHLIGHT_QUERY", "TypeScript": "tree_sitter_typescript::LANGUAGE_TYPESCRIPT, tree_sitter_typescript::HIGHLIGHTS_QUERY", "Json": "tree_sitter_json::LANGUAGE, tree_sitter_json::HIGHLIGHTS_QUERY", "Toml": "tree_sitter_toml_ng::LANGUAGE, tree_sitter_toml_ng::HIGHLIGHTS_QUERY", "Html": "tree_sitter_html::LANGUAGE, tree_sitter_html::HIGHLIGHTS_QUERY", "Css": "tree_sitter_css::LANGUAGE, tree_sitter_css::HIGHLIGHTS_QUERY", "Bash": "tree_sitter_bash::LANGUAGE, tree_sitter_bash::HIGHLIGHT_QUERY", "C": "tree_sitter_c::LANGUAGE, tree_sitter_c::HIGHLIGHT_QUERY", "Yaml": "tree_sitter_yaml::LANGUAGE, tree_sitter_yaml::HIGHLIGHTS_QUERY"} %}
{%- set cmenus = components | selectattr("type", "eq", p_ ~ "ContextMenu") | selectattr("field") | list %}

{#- A colour property as freya `Color`. -#}
{%- macro color(v) -%}
crate::app::color({{ v.r }}, {{ v.g }}, {{ v.b }}, {{ v.a }})
{%- endmacro %}

{#- Size and font of a text: own setting, else the form's (inherited). -#}
{%- macro text_style(c) -%}
{%- if c.props.font_size > 0 %}.font_size({{ c.props.font_size }} as f32){% endif -%}
{%- if c.props.bold %}.font_weight(FontWeight::BOLD){% endif -%}
{%- if c.props.italic %}.font_slant(FontSlant::Italic){% endif -%}
{%- endmacro %}

{%- macro padding(p) -%}
Gaps::new({{ p.top }} as f32, {{ p.right }} as f32, {{ p.bottom }} as f32, {{ p.left }} as f32)
{%- endmacro %}

{#- A clickable row with a box (check box, radio button) and its caption. -#}
{%- macro boxed(c, inner, message) -%}
rect()
    .horizontal()
    .spacing(6.0)
    .cross_align(Alignment::Center)
    .maybe(self.{{ c.name }}.enabled, |el| el.on_press(s.on::<Event<PressEventData>>({{ message }})))
    .maybe(!self.{{ c.name }}.enabled, |el| el.opacity(0.5))
    .child({{ inner }})
    .child(label().text(self.{{ c.name }}.caption.clone()){{ text_style(c) }})
{%- endmacro %}

{#- The widget `c` as an expression that converts into an Element. -#}
{%- macro widget(c, fill) -%}
{%- set t = c.type -%}
{%- if t == "core/Label" -%}
label().text(self.{{ c.name }}.value.clone()){{ text_style(c) }}{% if fill %}.width(Size::fill()){% endif %}
{%- elif t == "core/Button" -%}
Button::new()
    .enabled(self.{{ c.name }}.enabled)
    {%- if c.props.variant == "Filled" %}
    .filled()
    {%- elif c.props.variant == "Outline" %}
    .outline()
    {%- elif c.props.variant == "Flat" %}
    .flat()
    {%- endif %}
    {%- if c.props.compact %}
    .compact()
    {%- endif %}
    {%- if fill %}
    .width(Size::fill())
    {%- endif %}
    {%- if c.props.background.a > 0 %}
    .background({{ color(c.props.background) }})
    .hover_background({{ color(c.props.background) }})
    {%- endif %}
    {%- if c.props.foreground.a > 0 %}
    .color({{ color(c.props.foreground) }})
    {%- endif %}
    .on_press(s.on::<Event<PressEventData>>(Message::{{ c.name }}_click))
    .child(label().text(self.{{ c.name }}.caption.clone()){{ text_style(c) }})
{%- elif t == "core/Edit" -%}
Input::new(WritableSetter::new(self.{{ c.name }}.value.clone(), s.to(Message::{{ c.name }}_input)))
    .placeholder({{ c.rust.placeholder }})
    {%- if c.props.variant == "Filled" %}
    .filled()
    {%- elif c.props.variant == "Flat" %}
    .flat()
    {%- endif %}
    .enabled(self.{{ c.name }}.enabled{% if c.props.read_only %} && false{% endif %})
    {%- if c.props.password %}
    .mode(InputMode::new_password())
    {%- endif %}
    .on_submit(s.on::<String>(Message::{{ c.name }}_submit))
    {%- if fill %}
    .width(Size::fill())
    {%- endif %}
{%- elif t == "core/CheckBox" -%}
{{ boxed(c, "Checkbox::new().selected(self." ~ c.name ~ ".value)", "Message::" ~ c.name ~ "_toggle(!self." ~ c.name ~ ".value)") }}
{%- elif t == p_ ~ "RadioButton" -%}
{{ boxed(c, "RadioItem::new().selected(self." ~ c.name ~ ".value)", "Message::" ~ c.name ~ "_select") }}
{%- elif t == p_ ~ "Switch" -%}
rect()
    .horizontal()
    .spacing(6.0)
    .cross_align(Alignment::Center)
    .child(Switch::new(WritableSetter::new(self.{{ c.name }}.value, s.to(Message::{{ c.name }}_toggle))).enabled(self.{{ c.name }}.enabled))
    .maybe(!self.{{ c.name }}.caption.is_empty(), |el| el.child(label().text(self.{{ c.name }}.caption.clone()){{ text_style(c) }}))
{%- elif t == p_ ~ "Slider" -%}
{%- set span = "(" ~ c.rust.maximum ~ " - " ~ c.rust.minimum ~ ")" %}
rect()
    .horizontal()
    .spacing(8.0)
    .cross_align(Alignment::Center)
    .width(Size::fill())
    .content(Content::flex())
    .child(
        Slider::new(s.to(|percent: f64| Message::{{ c.name }}_change({{ c.rust.minimum }} + percent / 100.0 * {{ span }})))
            .value(if {{ span }} > 0.0 { (self.{{ c.name }}.value - {{ c.rust.minimum }}) / {{ span }} * 100.0 } else { 0.0 })
            .size(Size::flex(1.0))
            .enabled(self.{{ c.name }}.enabled),
    )
    {%- if c.props.show_value %}
    .child(label().text(format!("{}", self.{{ c.name }}.value)))
    {%- endif %}
{%- elif t == p_ ~ "ProgressBar" -%}
rect()
    .width(Size::fill())
    .spacing(2.0)
    .maybe(!self.{{ c.name }}.caption.is_empty(), |el| el.child(label().text(self.{{ c.name }}.caption.clone()).font_size(12.0)))
    .child(ProgressBar::new(self.{{ c.name }}.value * 100.0).width(Size::fill()).show_progress(false))
{%- elif t == p_ ~ "Select" -%}
Select::new()
    .selected_item(self.{{ c.name }}.items.get(self.{{ c.name }}.value).cloned().unwrap_or_default())
    .children(
        self.{{ c.name }}
            .items
            .iter()
            .enumerate()
            .filter(|_| self.{{ c.name }}.enabled)
            .map(|(index, item)| {
                MenuItem::new()
                    .selected(self.{{ c.name }}.value == index)
                    .on_press(s.on::<Event<PressEventData>>(Message::{{ c.name }}_select(index)))
                    .child(item.clone())
                    .into_element()
            }),
    )
{%- elif t == p_ ~ "ListBox" -%}
rect()
    .width(Size::fill())
    .height(Size::px(120.0))
    .padding(Gaps::new_all(2.0))
    .corner_radius(6.0)
    .border(Border::new().fill(crate::app::color(0x80, 0x80, 0x80, 110)).width(1.0))
    .child(ScrollView::new().width(Size::fill()).height(Size::fill()).children(self.{{ c.name }}.items.iter().enumerate().map(|(index, item)| {
        rect()
            .width(Size::fill())
            .padding(Gaps::new(4.0, 6.0, 4.0, 6.0))
            .maybe(self.{{ c.name }}.value == index as i32, |el| el.background(crate::app::color(0x3b, 0x82, 0xf6, 90)))
            .maybe(self.{{ c.name }}.enabled, |el| el.on_press(s.on::<Event<PressEventData>>(Message::{{ c.name }}_select(index))))
            .child(item.clone())
            .into_element()
    })))
{%- elif t == p_ ~ "TextEdit" -%}
Input::new(WritableSetter::new(self.{{ c.name }}.value.clone(), s.to(Message::{{ c.name }}_input)))
    .multiline(true)
    .enabled(self.{{ c.name }}.enabled{% if c.props.read_only %} && false{% endif %})
    .width(Size::fill())
    .height(Size::px({{ c.props.rows * 22 + 12 }} as f32))
{%- elif t == p_ ~ "Separator" -%}
{%- if c.props.vertical -%}
rect().width(Size::px(1.0)).height(Size::fill()).background(crate::app::color(0x80, 0x80, 0x80, 110))
{%- else -%}
rect().height(Size::px(1.0)).width(Size::fill()).background(crate::app::color(0x80, 0x80, 0x80, 110))
{%- endif -%}
{%- elif t == p_ ~ "Link" -%}
label()
    .text(if self.{{ c.name }}.caption.is_empty() { self.{{ c.name }}.value.clone() } else { self.{{ c.name }}.caption.clone() })
    .color(crate::app::color(0x3b, 0x82, 0xf6, 255)){{ text_style(c) }}
    .maybe(self.{{ c.name }}.enabled, |el| {
        let url = self.{{ c.name }}.value.clone();
        el.on_press(move |_| Platform::get().open_url(url.clone()))
    })
{%- elif t == "core/ImageBox" -%}
{%- set p = c.placement if c.placement and c.placement.kind == "layout" else none %}
rect()
    .width({% if fill or (p and (p.width > 0 or p.width_percent > 0)) %}Size::fill(){% else %}Size::px(96.0){% endif %})
    .height({% if p and (p.height > 0 or p.height_percent > 0) %}Size::fill(){% else %}Size::px(96.0){% endif %})
    .maybe(self.{{ c.name }}.enabled, |el| el.on_press(s.on::<Event<PressEventData>>(Message::{{ c.name }}_click)))
    .child(crate::app::picture_view(self.{{ c.name }}.value.source.as_ref(), &self.{{ c.name }}.value.fit))
{%- elif t == "core/ImageScrollBox" -%}
{%- set p = c.placement if c.placement and c.placement.kind == "layout" else none %}
{
    let gallery = &self.{{ c.name }}.value;
    let (w, h) = gallery.thumb;
    let thumbs = gallery.sources.iter().enumerate().map(|(index, source)| {
        rect()
            .width(Size::px(w))
            .height(Size::px(h))
            .padding(Gaps::new_all(2.0))
            .maybe(gallery.selected == Some(index), |el| el.border(Border::new().fill(crate::app::color(0x3b, 0x82, 0xf6, 255)).width(2.0)))
            .maybe(self.{{ c.name }}.enabled, |el| el.on_press(s.on::<Event<PressEventData>>(Message::{{ c.name }}_pick(index))))
            .child(crate::app::picture_view(source.as_ref(), &gallery.fit))
            .into_element()
    });
    let content: Element = match gallery.orientation.as_str() {
        "Horizontal" => ScrollView::new()
            .direction(Direction::Horizontal)
            .spacing(gallery.spacing)
            .width(Size::fill())
            .height(Size::fill())
            .children(thumbs)
            .into_element(),
        "Vertical" => ScrollView::new()
            .spacing(gallery.spacing)
            .width(Size::fill())
            .height(Size::fill())
            .children(thumbs)
            .into_element(),
        _ => ScrollView::new()
            .width(Size::fill())
            .height(Size::fill())
            .child(
                rect()
                    .width(Size::fill())
                    .horizontal()
                    .content(Content::wrap())
                    .spacing(gallery.spacing)
                    .children(thumbs),
            )
            .into_element(),
    };
    rect()
        .width({% if fill or (p and (p.width > 0 or p.width_percent > 0)) %}Size::fill(){% else %}Size::px(240.0){% endif %})
        .height({% if p and (p.height > 0 or p.height_percent > 0) %}Size::fill(){% else %}Size::px(128.0){% endif %})
        .child(content)
}
{%- elif t == p_ ~ "DataGrid" -%}
{%- set editable = c.props.editable and c.props.data_source %}
{
    let table = &self.{{ c.name }}.value;
    let enabled = self.{{ c.name }}.enabled;
    let header = TableRow::new().children(
        table.headers.iter().map(|title| rect().width(Size::fill()).child(label().text(title.clone()).font_weight(FontWeight::BOLD)).into_element()),
    );
    let rows = table.rows.iter().enumerate().map(|(index, row)| {
        let selected = table.selected == Some(index);
        TableRow::new()
            .children((0..table.headers.len()).map(|column| {
                let text = row.get(column).cloned().unwrap_or_default();
                {%- if editable %}
                // Bearbeitbar: ein Klick auf eine Zelle der gewählten Zeile bearbeitet sie,
                // Enter speichert die Zeile.
                if let Some((r, k, value)) = &table.editing
                    && *r == index
                    && *k == column
                {
                    return Input::new(WritableSetter::new(value.clone(), s.to(Message::{{ c.name }}_edit_input)))
                        .auto_focus(true)
                        .on_submit(s.on::<String>(Message::{{ c.name }}_edit_submit))
                        .width(Size::fill())
                        .into_element();
                }
                let press = if selected {
                    Message::{{ c.name }}_edit_start(index, column)
                } else {
                    Message::{{ c.name }}_select(index)
                };
                {%- else %}
                let press = Message::{{ c.name }}_select(index);
                {%- endif %}
                rect()
                    .width(Size::fill())
                    .maybe(selected, |el| el.background(crate::app::color(0x3b, 0x82, 0xf6, 90)))
                    .maybe(enabled, |el| el.on_press(s.on::<Event<PressEventData>>(press)))
                    .child(text)
                    .into_element()
            }))
            .into_element()
    });
    ScrollView::new()
        .width(Size::fill())
        .height(Size::px(160.0))
        .child(Table::new().width(Size::fill()).child(header).children(rows))
}
{%- elif t == p_ ~ "Chip" -%}
Chip::new()
    .selected(self.{{ c.name }}.value)
    .enabled(self.{{ c.name }}.enabled)
    .on_press(s.on::<Event<PressEventData>>(Message::{{ c.name }}_toggle(!self.{{ c.name }}.value)))
    .child(label().text(self.{{ c.name }}.caption.clone()){{ text_style(c) }})
{%- elif t == p_ ~ "Calendar" -%}
{
    let date = &self.{{ c.name }}.value;
    let (previous, next) = (date.previous(), date.next());
    let enabled = self.{{ c.name }}.enabled;
    let cell_sender = s.clone();
    rect()
        .spacing(4.0)
        .child(
            rect()
                .horizontal()
                .width(Size::px(7.0 * 36.0))
                .content(Content::flex())
                .cross_align(Alignment::Center)
                .child(Button::new().flat().compact().on_press(s.on::<Event<PressEventData>>(Message::{{ c.name }}_month(previous.0, previous.1))).child("‹"))
                .child(label().text(format!("{:04}-{:02}", date.view.0, date.view.1)).width(Size::flex(1.0)).text_align(TextAlign::Center))
                .child(Button::new().flat().compact().on_press(s.on::<Event<PressEventData>>(Message::{{ c.name }}_month(next.0, next.1))).child("›")),
        )
        .maybe_child(date.month().map(|month| {
            rect()
                .spacing(2.0)
                .child(
                    rect()
                        .horizontal()
                        .children(month.weekdays.iter().map(|day| {
                            label().text(format!("{day}")).width(Size::px(36.0)).text_align(TextAlign::Center).opacity(0.7).into_element()
                        })),
                )
                .child(CalendarGrid::new(month, move |day: CalendarDay| {
                    let (y, m, d) = (day.date.year, day.date.month, day.date.day);
                    rect()
                        .width(Size::px(36.0))
                        .height(Size::px(30.0))
                        .center()
                        .corner_radius(6.0)
                        .maybe(day.selected, |el| el.background(crate::app::color(0x3b, 0x82, 0xf6, 160)))
                        .maybe(!day.in_month, |el| el.opacity(0.4))
                        .maybe(enabled, |el| el.on_press(cell_sender.on::<Event<PressEventData>>(Message::{{ c.name }}_select(y, m, d))))
                        .child(d.to_string())
                        .into_element()
                }))
        }))
}
{%- elif t == p_ ~ "ColorPicker" -%}
ColorPicker::new(s.to(Message::{{ c.name }}_change)).value(self.{{ c.name }}.value)
{%- elif t == p_ ~ "Loader" -%}
CircularLoader::new().size({{ c.props.size }} as f32)
{%- elif t == p_ ~ "SegmentedButton" -%}
SegmentedButton::new().children(self.{{ c.name }}.items.iter().enumerate().map(|(index, item)| {
    ButtonSegment::new()
        .selected(self.{{ c.name }}.value == index)
        .enabled(self.{{ c.name }}.enabled)
        .on_press(s.on::<Event<PressEventData>>(Message::{{ c.name }}_select(index)))
        .child(item.clone())
        .into_element()
}))
{%- elif t == p_ ~ "SelectableText" -%}
SelectableText::new().span(self.{{ c.name }}.value.clone()){% if fill %}.width(Size::fill()){% endif %}
{%- elif t == p_ ~ "Paragraph" -%}
paragraph()
    .span(self.{{ c.name }}.value.clone())
    {%- if c.props.max_lines > 0 %}
    .max_lines({{ c.props.max_lines }}usize)
    {%- endif %}
    .text_align(TextAlign::{{ c.props.text_align }}){{ text_style(c) }}
    .width(Size::fill())
{%- elif t == p_ ~ "Marquee" -%}
OverflowedContent::new()
    .width(Size::fill())
    .duration(std::time::Duration::from_millis({{ c.props.duration_ms }}))
    {%- if c.props.left_to_right %}
    .left_to_right()
    {%- endif %}
    .child(label().text(self.{{ c.name }}.value.clone()){{ text_style(c) }})
{%- elif t in [p_ ~ "Svg", p_ ~ "Gif"] -%}
{%- set p = c.placement if c.placement and c.placement.kind == "layout" else none %}
{%- if t == p_ ~ "Svg" %}SvgViewer{% else %}GifViewer{% endif %}::new(std::path::PathBuf::from(&self.{{ c.name }}.value))
    .width({% if fill or (p and (p.width > 0 or p.width_percent > 0)) %}Size::fill(){% else %}Size::px(48.0){% endif %})
    .height({% if p and (p.height > 0 or p.height_percent > 0) %}Size::fill(){% else %}Size::px(48.0){% endif %})
    {%- if t == p_ ~ "Svg" and c.props.color.a > 0 %}
    .fill({{ color(c.props.color) }})
    {%- endif %}
{%- elif t == p_ ~ "VirtualList" -%}
VirtualScrollView::new_with_data(
    (self.{{ c.name }}.items.clone(), self.{{ c.name }}.value, self.{{ c.name }}.enabled, s.clone()),
    |item: VirtualItem, (items, value, enabled, s): &(Vec<String>, i32, bool, Sender)| {
        rect()
            .width(Size::fill())
            .height(Size::px({{ c.props.item_height }} as f32))
            .padding(Gaps::new(4.0, 6.0, 4.0, 6.0))
            .maybe(*value == item.index as i32, |el| el.background(crate::app::color(0x3b, 0x82, 0xf6, 90)))
            .maybe(*enabled, |el| el.on_press(s.on::<Event<PressEventData>>(Message::{{ c.name }}_select(item.index))))
            .child(items.get(item.index).cloned().unwrap_or_default())
            .into_element()
    },
)
.length(self.{{ c.name }}.items.len())
.item_size({{ c.props.item_height }} as f32)
.width(Size::fill())
.height(Size::px(160.0))
{%- elif t == p_ ~ "SideBar" -%}
rect().width(Size::fill()).spacing(2.0).children(self.{{ c.name }}.items.iter().enumerate().map(|(index, item)| {
    rect()
        .width(Size::fill())
        .corner_radius(6.0)
        .maybe(self.{{ c.name }}.value == index, |el| el.background(crate::app::color(0x3b, 0x82, 0xf6, 90)))
        .child(
            SideBarItem::new()
                .on_press(s.on::<Event<PressEventData>>(Message::{{ c.name }}_select(index)))
                .child(item.clone()),
        )
        .into_element()
}))
{%- elif t == p_ ~ "Markdown" -%}
MarkdownViewer::new(self.{{ c.name }}.value.clone()).width(Size::fill())
{%- elif t in [p_ ~ "CodeEditor", p_ ~ "Terminal", p_ ~ "Chart", p_ ~ "Canvas", p_ ~ "Camera", p_ ~ "Video", p_ ~ "HtmlView"] -%}
{%- set p = c.placement if c.placement and c.placement.kind == "layout" else none %}
{%- set default_h = {"CodeEditor": 200, "Terminal": 240, "Chart": 200, "Canvas": 160, "Camera": 240, "Video": 240, "HtmlView": 240}[c.type_name] %}
rect()
    .width({% if fill or (p and (p.width > 0 or p.width_percent > 0)) %}Size::fill(){% else %}Size::px(320.0){% endif %})
    .height({% if p and (p.height > 0 or p.height_percent > 0) %}Size::fill(){% else %}Size::px({{ default_h }}.0){% endif %})
{%- if t == p_ ~ "CodeEditor" %}
    .child(crate::app::CodeView {
        text: self.{{ c.name }}.value.clone(),
        language: || {% if c.props.language == "Plain" %}None{% else %}Some(freya::code_editor::EditorLanguage::new({{ languages[c.props.language] }})){% endif %},
        read_only: {{ "true" if c.props.read_only else "false" }} || !self.{{ c.name }}.enabled,
        line_numbers: {{ "true" if c.props.line_numbers else "false" }},
        font_family: {{ c.rust.font_family }},
        font_size: {{ c.props.font_size if c.props.font_size > 0 else 14 }} as f32,
        on_change: s.to(Message::{{ c.name }}_input).into(),
    })
{%- elif t == p_ ~ "Terminal" %}
    .child(crate::app::TerminalView {
        command: self.{{ c.name }}.value.clone(),
        font_size: {{ c.props.font_size if c.props.font_size > 0 else 14 }} as f32,
        font_family: {{ c.rust.font_family }},
        on_exit: s.on::<()>(Message::{{ c.name }}_exit).into(),
    })
{%- elif t == p_ ~ "Chart" %}
    .background(RenderCallback::new({
        let values = self.{{ c.name }}.value.clone();
        let title = self.{{ c.name }}.caption.clone();
        move |context| crate::app::draw_chart(context, &values, &title, "{{ c.props.kind }}", ({{ c.props.color.r }}, {{ c.props.color.g }}, {{ c.props.color.b }}))
    }))
{%- elif t == p_ ~ "Canvas" and c.events.on_draw %}
    .background(RenderCallback::new({
        let form = s.form.clone();
        move |context| {
            let (width, height) = (context.size.width, context.size.height);
            if let RenderTarget::Background { canvas, .. } = &mut context.target
