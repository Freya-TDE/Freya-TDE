/// Entries of a main menu: path parts and shortcut (`File/Open | Ctrl+O`).
#[allow(dead_code)]
pub fn menu_entries(items: &[String]) -> Vec<(Vec<String>, String)> {
    menu_entries_min(items, 2)
}

/// Menu entries with at least `min` path parts (a context menu: 1).
#[allow(dead_code)]
pub fn menu_entries_min(items: &[String], min: usize) -> Vec<(Vec<String>, String)> {
    items
        .iter()
        .map(|item| {
            let (path, keys) = item.split_once('|').unwrap_or((item.as_str(), ""));
            let parts: Vec<String> = path.split('/').map(|p| p.trim().to_owned()).collect();
            (parts, keys.trim().to_owned())
        })
        .filter(|(parts, _)| parts.len() >= min && !parts.iter().any(String::is_empty))
        .collect()
}

/// The menu entries below `prefix`: buttons, separators (`-`) and submenus;
/// `choose` gets the path of the chosen entry (`File/Export/PDF`).
#[allow(dead_code)]
pub fn menu_items(
    entries: &[(Vec<String>, String)],
    prefix: &[String],
    choose: std::rc::Rc<dyn Fn(String)>,
) -> Vec<Element> {
    let depth = prefix.len();
    let mut seen: Vec<String> = Vec::new();
    let mut out = Vec::new();
    for (parts, keys) in entries {
        if parts.len() <= depth || !parts.starts_with(prefix) {
            continue;
        }
        let name = parts[depth].clone();
        if parts.len() == depth + 1 {
            if name == "-" {
                out.push(
                    rect()
                        .height(Size::px(1.0))
                        .width(Size::fill())
                        .background(color(0x80, 0x80, 0x80, 110))
                        .into_element(),
                );
            } else {
                let path = parts.join("/");
                let choose = choose.clone();
                out.push(
                    MenuButton::new()
                        .on_press(move |_| choose(path.clone()))
                        .child(
                            rect()
                                .horizontal()
                                .spacing(24.0)
                                .child(label().text(name))
                                .maybe(!keys.is_empty(), |el| el.child(label().text(keys.clone()).opacity(0.6))),
                        )
                        .into_element(),
                );
            }
        } else if !seen.contains(&name) {
            seen.push(name.clone());
            let mut sub = prefix.to_vec();
            sub.push(name.clone());
            out.push(
                SubMenu::new()
                    .label(label().text(name))
                    .children(menu_items(entries, &sub, choose.clone()))
                    .into_element(),
            );
        }
    }
    out
}

/// The top-level menus in the order of the entries.
#[allow(dead_code)]
pub fn menu_titles(items: &[String]) -> Vec<String> {
    let mut titles: Vec<String> = Vec::new();
    for (parts, _) in menu_entries(items) {
        if !titles.contains(&parts[0]) {
            titles.push(parts[0].clone());
        }
    }
    titles
}

/// The menu entry whose shortcut (`Ctrl+O`, `Ctrl+Shift+S`, `F5`) was pressed.
#[allow(dead_code)]
pub fn menu_shortcut(items: &[String], event: &freya::prelude::KeyboardEventData) -> Option<String> {
    let pressed = match &event.key {
        Key::Character(c) => c.to_lowercase(),
        Key::Named(named) => format!("{named:?}").to_lowercase(),
    };
    menu_entries(items).into_iter().find_map(|(parts, keys)| {
        if keys.is_empty() {
            return None;
        }
        let mut want = Modifiers::empty();
        let mut key = String::new();
        for part in keys.split('+').map(str::trim) {
            match part.to_lowercase().as_str() {
                "ctrl" | "control" | "cmd" => want |= if cfg!(target_os = "macos") { Modifiers::META } else { Modifiers::CONTROL },
                "shift" => want |= Modifiers::SHIFT,
                "alt" => want |= Modifiers::ALT,
                other => key = other.to_owned(),
            }
        }
        let mods = event.modifiers & (Modifiers::CONTROL | Modifiers::META | Modifiers::SHIFT | Modifiers::ALT);
        (key == pressed && mods == want).then(|| parts.join("/"))
    })
}
