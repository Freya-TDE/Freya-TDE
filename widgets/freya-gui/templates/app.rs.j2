/// State of a Calendar: the selected day and the month shown.
#[allow(dead_code)]
#[derive(Debug, Clone, PartialEq)]
pub struct Date {
    /// (year, month, day) of the selected day.
    pub selected: Option<(i32, u32, u32)>,
    /// (year, month) of the month shown.
    pub view: (i32, u32),
    /// Weeks start on Sunday (else Monday).
    pub sunday: bool,
}

#[allow(dead_code)]
impl Date {
    /// From `YYYY-MM-DD` (empty or invalid = nothing selected, this month shown).
    pub fn parse(text: &str, sunday: bool) -> Self {
        let mut parts = text.trim().splitn(3, '-').map(|p| p.parse::<u32>().ok());
        let selected = match (parts.next().flatten(), parts.next().flatten(), parts.next().flatten()) {
            (Some(y), Some(m), Some(d)) if (1..=12).contains(&m) && (1..=31).contains(&d) => Some((y as i32, m, d)),
            _ => None,
        };
        let view = selected.map(|(y, m, _)| (y, m)).unwrap_or_else(|| {
            let today = CalendarDate::now();
            (today.year, today.month)
        });
        Self { selected, view, sunday }
    }

    /// The days of the month shown, for `CalendarGrid`.
    pub fn month(&self) -> Option<CalendarMonth> {
        CalendarMonth::new(
            CalendarDate::new(self.view.0, self.view.1, 1),
            self.selected.map(|(y, m, d)| CalendarDate::new(y, m, d)),
            if self.sunday { WeekStart::Sunday } else { WeekStart::Monday },
        )
    }

    /// (year, month) before / after the month shown.
    pub fn previous(&self) -> (i32, u32) {
        if self.view.1 == 1 { (self.view.0 - 1, 12) } else { (self.view.0, self.view.1 - 1) }
    }
    pub fn next(&self) -> (i32, u32) {
        if self.view.1 == 12 { (self.view.0 + 1, 1) } else { (self.view.0, self.view.1 + 1) }
    }
}
