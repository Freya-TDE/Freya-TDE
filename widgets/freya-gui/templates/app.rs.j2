/// Fades the background to `color` while the mouse is over `child`.
#[derive(PartialEq)]
pub struct Hover {
    pub color: Color,
    pub ms: u64,
    pub child: Element,
}

impl Component for Hover {
    fn render(&self) -> impl IntoElement {
        use freya::animation::*;
        let mut target = use_state(|| Color::TRANSPARENT);
        let ms = self.ms;
        let animation = use_animation_transition(target, move |from: Color, to| AnimColor::new(from, to).time(ms));
        let color = self.color;
        rect()
            .background(&*animation.read())
            .on_pointer_enter(move |_| target.set(color))
            .on_pointer_leave(move |_| target.set(Color::TRANSPARENT))
            .child(self.child.clone())
    }
}

/// Animates `child` when it appears: `Fade`, `Slide` or `Grow`.
#[derive(PartialEq)]
pub struct Appear {
    pub kind: &'static str,
    pub ms: u64,
    pub child: Element,
}

impl Component for Appear {
    fn render(&self) -> impl IntoElement {
        use freya::animation::*;
        let ms = self.ms;
        let animation = use_animation(move |conf| {
            conf.on_creation(OnCreation::Run);
            AnimNum::new(0.0, 1.0).time(ms)
        });
        let t = animation.read().value();
        let el = rect().child(self.child.clone());
        match self.kind {
            "Slide" => el.opacity(t).offset_y((1.0 - t) * 24.0),
            "Grow" => el.opacity(t).scale(0.6 + 0.4 * t),
            _ => el.opacity(t),
        }
    }
}

