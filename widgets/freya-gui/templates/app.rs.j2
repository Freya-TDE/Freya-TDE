/// An HtmlView: shows `url` (or `html`), follows changes of the form.
#[derive(PartialEq)]
pub struct HtmlView {
    pub url: String,
    pub html: String,
}

impl Component for HtmlView {
    fn render(&self) -> impl IntoElement {
        use freya::html::*;
        let source = |url: &str, html: &str| {
            if url.trim().is_empty() {
                HtmlSource::html(html.to_owned())
            } else {
                HtmlSource::url(url.to_owned())
            }
        };
        let first = source(&self.url, &self.html);
        let mut handle = use_hook(move || HtmlHandle::create(first));
        let shown = use_hook(|| std::rc::Rc::new(std::cell::RefCell::new((self.url.clone(), self.html.clone()))));
        if *shown.borrow() != (self.url.clone(), self.html.clone()) {
            *shown.borrow_mut() = (self.url.clone(), self.html.clone());
            if self.url.trim().is_empty() {
                handle.load_html(self.html.clone());
            } else {
                handle.navigate(self.url.clone());
            }
        }
        HtmlViewer::new(handle)
    }
}
