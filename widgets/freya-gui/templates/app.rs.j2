/// A Terminal: starts `command` (empty = the system shell) in a pseudo
/// terminal; mouse, keys, selection and clipboard as in freya's example.
#[derive(PartialEq)]
pub struct TerminalView {
    pub command: String,
    pub font_size: f32,
    pub font_family: &'static str,
    pub on_exit: EventHandler<()>,
}

impl Component for TerminalView {
    fn render(&self) -> impl IntoElement {
        use freya::terminal::*;
        use futures_util::FutureExt as _;
        let command = self.command.clone();
        let mut handle = use_state(move || {
            let program = if command.trim().is_empty() {
                if cfg!(windows) {
                    std::env::var("COMSPEC").unwrap_or_else(|_| "cmd.exe".into())
                } else {
                    std::env::var("SHELL").unwrap_or_else(|_| "sh".into())
                }
            } else {
                command.clone()
            };
            let mut parts = program.split_whitespace();
            let mut cmd = CommandBuilder::new(parts.next().unwrap_or("sh"));
            cmd.args(parts);
            cmd.env("TERM", "xterm-256color");
            cmd.env("COLORTERM", "truecolor");
            TerminalHandle::new(TerminalId::new(), PtyBackend::new(cmd), None).ok()
        });
        let on_exit = self.on_exit.clone();
        use_future(move || {
            let on_exit = on_exit.clone();
            async move {
            let Some(terminal) = handle.read().clone() else {
                return;
            };
            loop {
                futures_util::select! {
                    _ = terminal.closed().fuse() => {
                        let _ = handle.write().take();
                        on_exit.call(());
                        break;
                    }
                    _ = terminal.clipboard_changed().fuse() => {
                        if let Some(text) = terminal.clipboard_content() {
                            let _ = freya::clipboard::Clipboard::set(text);
                        }
                    }
                }
            }
            }
        });
        let a11y_id = use_a11y();
        let focus = use_focus(a11y_id);
        let mut dimensions = use_state(|| (1.0f32, 1.0f32));
        use_side_effect(move || {
            let focused = *Platform::get().current_window().is_app_focused.read() && focus().is_focused();
            if let Some(handle) = handle.read().clone() {
                handle.focus_changed(focused);
            }
        });
        let cell = move |x: f64, y: f64| {
            let (char_width, line_height) = dimensions();
            ((y / line_height as f64) as f32, (x / char_width as f64) as f32)
        };
        let Some(terminal) = handle.read().clone() else {
            return rect().padding(6.0).child("Terminal exited").into_element();
        };
        rect()
            .width(Size::fill())
            .height(Size::fill())
            .background((10, 10, 10))
            .padding(6.0)
            .child(
                Terminal::new(terminal.clone())
                    .font_size(self.font_size)
                    .font_family(self.font_family)
                    .on_measured(move |size: (f32, f32)| dimensions.set(size))
                    .on_mouse_down({
                        let terminal = terminal.clone();
                        move |e: Event<MouseEventData>| {
                            a11y_id.request_focus();
                            let (row, col) = cell(e.element_location.x, e.element_location.y);
                            let button = match e.button {
                                Some(MouseButton::Middle) => TerminalMouseButton::Middle,
                                Some(MouseButton::Right) => TerminalMouseButton::Right,
                                _ => TerminalMouseButton::Left,
                            };
                            let selection = match EventsCombos::<()>::pressed(e.element_location) {
                                PressEventType::Double => SelectionType::Semantic,
                                PressEventType::Triple => SelectionType::Lines,
                                _ => SelectionType::Simple,
                            };
                            terminal.mouse_down(row, col, button, selection);
                        }
                    })
                    .on_mouse_move({
                        let terminal = terminal.clone();
                        move |e: Event<MouseEventData>| {
                            let (row, col) = cell(e.element_location.x, e.element_location.y);
                            terminal.mouse_move(row, col);
                        }
                    })
                    .on_mouse_up({
                        let terminal = terminal.clone();
                        move |e: Event<MouseEventData>| {
                            let (row, col) = cell(e.element_location.x, e.element_location.y);
                            let button = match e.button {
                                Some(MouseButton::Middle) => TerminalMouseButton::Middle,
                                Some(MouseButton::Right) => TerminalMouseButton::Right,
                                _ => TerminalMouseButton::Left,
                            };
                            terminal.mouse_up(row, col, button);
                        }
                    })
                    .on_global_pointer_up({
                        let terminal = terminal.clone();
                        move |_: Event<PointerEventData>| terminal.release()
                    })
                    .on_wheel({
                        let terminal = terminal.clone();
                        move |e: Event<WheelEventData>| {
                            let (row, col) = cell(e.element_location.x, e.element_location.y);
                            terminal.wheel(e.delta_y, row, col);
                        }
                    })
                    .a11y_id(a11y_id)
                    .a11y_role(AccessibilityRole::Terminal)
                    .on_key_up({
                        let terminal = terminal.clone();
                        move |e: Event<KeyboardEventData>| {
                            if e.key == Key::Named(NamedKey::Shift) {
                                terminal.shift_pressed(false);
                            }
                        }
                    })
                    .on_key_down(move |e: Event<KeyboardEventData>| {
                        let ctrl_shift = e.modifiers.contains(Modifiers::CONTROL | Modifiers::SHIFT);
                        match &e.key {
                            Key::Character(ch) if ctrl_shift && ch.eq_ignore_ascii_case("c") => {
                                if let Some(text) = terminal.get_selected_text() {
                                    let _ = freya::clipboard::Clipboard::set(text);
                                }
                            }
                            Key::Character(ch) if ctrl_shift && ch.eq_ignore_ascii_case("v") => {
                                if let Ok(text) = freya::clipboard::Clipboard::get() {
                                    let _ = terminal.paste(&text);
                                }
                            }
                            _ => {
                                let _ = terminal.write_key(&e.key, e.modifiers);
                            }
                        }
                    }),
            )
            .into_element()
    }
}
