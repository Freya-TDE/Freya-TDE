/// A picture prepared by `freya_image` (gamma, opacity) as PNG for freya.
fn freya_png(path: &str, gamma: f64, opacity: f64) -> Option<freya::prelude::Bytes> {
    let picture = match super::freya_image(path, gamma, opacity) {
        Ok(picture) => picture,
        Err(error) => {
            eprintln!("{error}");
            return None;
        }
    };
    let image = image::RgbaImage::from_raw(picture.width, picture.height, picture.rgba.to_vec())?;
    let mut png = std::io::Cursor::new(Vec::new());
    image.write_to(&mut png, image::ImageFormat::Png).ok()?;
    Some(freya::prelude::Bytes::from(png.into_inner()))
}

/// How a picture fits its place (Cover, Stretch, Contain, Center).
#[allow(dead_code)]
pub fn aspect_ratio(fit: &str) -> freya::prelude::AspectRatio {
    match fit {
        "Cover" => freya::prelude::AspectRatio::Max,
        "Stretch" => freya::prelude::AspectRatio::None,
        "Center" => freya::prelude::AspectRatio::Fit,
        _ => freya::prelude::AspectRatio::Min,
    }
}

/// The picture as an element filling its place (empty without a picture).
#[allow(dead_code)]
pub fn picture_view(source: Option<&(String, freya::prelude::Bytes)>, fit: &str) -> freya::prelude::Element {
    match source {
        Some((key, bytes)) => freya::prelude::ImageViewer::new((key.clone(), bytes.clone()))
            .width(freya::prelude::Size::fill())
            .height(freya::prelude::Size::fill())
            .aspect_ratio(aspect_ratio(fit))
            .image_cover(if fit == "Center" { freya::prelude::ImageCover::Center } else { freya::prelude::ImageCover::Fill })
            .into_element(),
        None => freya::prelude::rect().into_element(),
    }
}

/// State of an ImageBox; `set_file` loads another picture.
#[allow(dead_code)]
pub struct Picture {
    pub file: String,
    pub fit: String,
    pub gamma: f64,
    pub opacity: f64,
    /// Cache key and PNG bytes of the prepared picture.
    pub source: Option<(String, freya::prelude::Bytes)>,
}

#[allow(dead_code)]
impl Picture {
    pub fn new(file: &str, fit: &str, gamma: f64, opacity: f64) -> Self {
        let mut picture = Self {
            file: String::new(),
            fit: fit.to_owned(),
            gamma,
            opacity,
            source: None,
        };
        picture.set_file(file);
        picture
    }

    pub fn set_file(&mut self, file: &str) {
        self.file = file.to_owned();
        // Adressen (`https://…`) lädt freya selbst (Feature `remote-asset`).
        self.source = (!file.is_empty() && !file.contains("://"))
            .then(|| freya_png(file, self.gamma, self.opacity))
            .flatten()
            .map(|bytes| (format!("{file}|{}|{}", self.gamma, self.opacity), bytes));
    }
}

/// State of an ImageScrollBox; the paths are the control's `items`,
/// `load` prepares their pictures.
#[allow(dead_code)]
pub struct Gallery {
    pub selected: Option<usize>,
    pub orientation: String,
    pub thumb: (f32, f32),
    pub spacing: f32,
    pub fit: String,
    pub gamma: f64,
    pub opacity: f64,
    pub sources: Vec<Option<(String, freya::prelude::Bytes)>>,
}

#[allow(dead_code)]
impl Gallery {
    pub fn new(orientation: &str, thumb: (i32, i32), spacing: i64, fit: &str, gamma: f64, opacity: f64) -> Self {
        Self {
            selected: None,
            orientation: orientation.to_owned(),
            thumb: (thumb.0 as f32, thumb.1 as f32),
            spacing: spacing as f32,
            fit: fit.to_owned(),
            gamma,
            opacity,
            sources: Vec::new(),
        }
    }

    /// Prepares the pictures of `paths`; the selection starts over.
    pub fn load(&mut self, paths: &[String]) {
        self.selected = None;
        self.sources = paths
            .iter()
            .map(|path| {
                freya_png(path, self.gamma, self.opacity)
                    .map(|bytes| (format!("{path}|{}|{}", self.gamma, self.opacity), bytes))
            })
            .collect();
    }

    /// Same as `load`, for the initial state.
    pub fn loaded(mut self, paths: &[&str]) -> Self {
        self.load(&paths.iter().map(|p| p.to_string()).collect::<Vec<_>>());
        self
    }
}
