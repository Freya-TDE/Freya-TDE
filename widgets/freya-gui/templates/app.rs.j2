/// The state of a widget: the view is built from these values, so a handler
/// changes the widget by changing them (`self.ok_button.enabled = false`,
/// `self.greeting.value = …`). `value` is reachable directly through `Deref`
/// (`self.name_edit.trim()`).
#[allow(dead_code)]
#[derive(Debug)]
pub struct Control<T> {
    /// What the widget shows or edits (text, checked, number, selection …).
    pub value: T,
    /// Caption of buttons, check boxes, cards; title of the window.
    pub caption: String,
    /// Entries of lists and selects; titles of tabs; entries of the menu.
    pub items: Vec<String>,
    pub enabled: bool,
    pub visible: bool,
    /// Hint shown on hover (empty = none).
    pub tooltip: String,
}

#[allow(dead_code)]
impl<T> Control<T> {
    pub fn new(value: T) -> Self {
        Self {
            value,
            caption: String::new(),
            items: Vec::new(),
            enabled: true,
            visible: true,
            tooltip: String::new(),
        }
    }

    pub fn with_caption(mut self, caption: impl Into<String>) -> Self {
        self.caption = caption.into();
        self
    }

    pub fn with_items<S: ToString>(mut self, items: Vec<S>) -> Self {
        self.items = items.iter().map(ToString::to_string).collect();
        self
    }

    pub fn with_state(mut self, enabled: bool, visible: bool, tooltip: &str) -> Self {
        self.enabled = enabled;
        self.visible = visible;
        self.tooltip = tooltip.to_owned();
        self
    }

    /// `element` as shown: nothing if hidden, with tooltip if one is set.
    pub fn show(&self, element: impl freya::prelude::IntoElement) -> freya::prelude::Element {
        if !self.visible {
            return freya::prelude::rect().into_element();
        }
        if self.tooltip.is_empty() {
            element.into_element()
        } else {
            freya::prelude::TooltipContainer::new(freya::prelude::Tooltip::new_text(self.tooltip.clone()))
                .child(element)
                .into_element()
        }
    }
}

impl<T> std::ops::Deref for Control<T> {
    type Target = T;
    fn deref(&self) -> &T {
        &self.value
    }
}

impl<T> std::ops::DerefMut for Control<T> {
    fn deref_mut(&mut self) -> &mut T {
        &mut self.value
    }
}

/// A form that reacts to its messages (generated per form).
pub trait FreyaUpdate: 'static {
    type Message: 'static;
    fn update(&mut self, message: Self::Message);
}

/// Hands messages to the form and lets freya render again.
pub struct FreyaSender<F: FreyaUpdate> {
    pub form: std::rc::Rc<std::cell::RefCell<F>>,
    pub tick: freya::prelude::State<u64>,
}

impl<F: FreyaUpdate> Clone for FreyaSender<F> {
    fn clone(&self) -> Self {
        Self {
            form: self.form.clone(),
            tick: self.tick,
        }
    }
}

impl<F: FreyaUpdate> PartialEq for FreyaSender<F> {
    fn eq(&self, other: &Self) -> bool {
        std::rc::Rc::ptr_eq(&self.form, &other.form)
    }
}

#[allow(dead_code)]
impl<F: FreyaUpdate> FreyaSender<F> {
    pub fn send(&self, message: F::Message) {
        self.form.borrow_mut().update(message);
        let mut tick = self.tick;
        *tick.write() += 1;
    }

    /// A callback that sends `message(value)`.
    pub fn to<T: 'static>(&self, message: impl Fn(T) -> F::Message + 'static) -> impl FnMut(T) + 'static {
        let sender = self.clone();
        move |value| sender.send(message(value))
    }

    /// A callback that sends `message`, ignoring the event.
    pub fn on<E: 'static>(&self, message: F::Message) -> impl FnMut(E) + 'static
    where
        F::Message: Clone,
    {
        let sender = self.clone();
        move |_| sender.send(message.clone())
    }
}

/// A form shown in a freya window (generated per form).
pub trait FreyaView: FreyaUpdate + Sized {
    /// The window content from the state.
    fn freya_view(&self, sender: &FreyaSender<Self>) -> Element;
    /// The window title (caption of the form).
    fn freya_title(&self) -> String;
    /// `Dark`, `Light` or `System` (the form's `theme`).
    const THEME: &'static str;
    /// Once at the start, with the sender (data binding: wake on new rows).
    fn freya_watch(_sender: &FreyaSender<Self>) {}
}

/// The root component of a form's window: renders the form again after
/// every message (`tick`), keeps the title up to date.
pub struct FreyaRoot<F>(pub std::rc::Rc<std::cell::RefCell<F>>);

impl<F: FreyaView> App for FreyaRoot<F> {
    fn render(&self) -> impl IntoElement {
        let tick = use_state(|| 0u64);
        let _ = *tick.read();
        let sender = FreyaSender {
            form: self.0.clone(),
            tick,
        };
        use_init_theme(|| match F::THEME {
            "Dark" => dark_theme(),
            "Light" => light_theme(),
            _ => Platform::get().current_window().preferred_theme.peek().to_theme(),
        });
        use_hook({
            let sender = sender.clone();
            move || F::freya_watch(&sender)
        });
        // Titel nur setzen, wenn er sich geändert hat.
        let shown = use_hook(|| std::rc::Rc::new(std::cell::RefCell::new(String::new())));
        let title = self.0.borrow().freya_title();
        if *shown.borrow() != title {
            *shown.borrow_mut() = title.clone();
            Platform::get().with_window(Platform::window_id(), move |window| window.set_title(&title));
        }
        let form = self.0.borrow();
        form.freya_view(&sender)
    }
}

