/// A Video: plays `file`, follows `playing`; the controls report changes.
#[derive(PartialEq)]
pub struct VideoView {
    pub file: String,
    pub playing: bool,
    pub controls: bool,
    pub on_playing: EventHandler<bool>,
}

impl Component for VideoView {
    fn render(&self) -> impl IntoElement {
        use freya::video::*;
        let file = self.file.clone();
        let mut player = use_hook(move || VideoPlayer::create(VideoSource(std::path::PathBuf::from(file))));
        let applied = use_hook(|| std::rc::Rc::new(std::cell::RefCell::new((self.file.clone(), !self.playing))));
        if applied.borrow().0 != self.file {
            player.set_source(VideoSource(std::path::PathBuf::from(&self.file)));
            applied.borrow_mut().0 = self.file.clone();
        }
        if applied.borrow().1 != self.playing {
            if self.playing {
                player.play();
            } else {
                player.pause();
            }
            applied.borrow_mut().1 = self.playing;
        }
        let picture: Element = match (player.frame(), player.state()) {
            (Some(frame), _) => image(frame)
                .width(Size::fill())
                .height(Size::fill())
                .aspect_ratio(AspectRatio::Min)
                .image_cover(ImageCover::Center)
                .into_element(),
            (_, PlaybackState::Errored) => label().text("Video failed to load").into_element(),
            _ => CircularLoader::new().into_element(),
        };
        let playing = self.playing;
        let on_playing = self.on_playing.clone();
        rect()
            .width(Size::fill())
            .height(Size::fill())
            .content(Content::flex())
            .spacing(6.0)
            .child(rect().width(Size::fill()).height(Size::flex(1.0)).center().child(picture))
            .maybe(self.controls, |el| {
                el.child(
                    rect()
                        .horizontal()
                        .width(Size::fill())
                        .content(Content::flex())
                        .cross_align(Alignment::Center)
                        .spacing(8.0)
                        .child(
                            Button::new()
                                .flat()
                                .compact()
                                .on_press(move |_| on_playing.call(!playing))
                                .child(if playing { "⏸" } else { "▶" }),
                        )
                        .child(
                            Slider::new(move |percent: f64| {
                                if let Some(duration) = player.duration() {
                                    player.seek(
                                        std::time::Duration::from_secs_f64(duration.as_secs_f64() * percent / 100.0),
                                        std::time::Duration::from_millis(150),
                                    );
                                }
                            })
                            .value(player.progress())
                            .size(Size::flex(1.0)),
                        )
                        .child(
                            Slider::new(move |percent: f64| player.set_volume((percent / 100.0) as f32))
                                .value(player.volume() as f64 * 100.0)
                                .size(Size::px(80.0)),
                        ),
                )
            })
    }
}
