/// Draws a chart of `values` with plotters (Line, Bar, Points, Area).
pub fn draw_chart(context: &mut FillRenderContext, values: &[f64], title: &str, kind: &str, rgb: (u8, u8, u8)) {
    use freya::plot::{PlotSkiaBackend, plotters::prelude::*};
    let size = (context.size.width as i32, context.size.height as i32);
    let RenderTarget::Background { canvas, font_collection } = &mut context.target else {
        return;
    };
    let root = PlotSkiaBackend::new(canvas, font_collection, size).into_drawing_area();
    let count = values.len().max(1);
    let low = values.iter().copied().fold(0.0f64, f64::min);
    let high = values.iter().copied().fold(1.0f64, f64::max);
    let pad = (high - low).abs().max(1.0) * 0.05;
    let color = RGBColor(rgb.0, rgb.1, rgb.2);
    let Ok(mut chart) = ChartBuilder::on(&root)
        .caption(title, ("sans-serif", 14))
        .margin(8)
        .x_label_area_size(22)
        .y_label_area_size(36)
        .build_cartesian_2d(0f64..count as f64, (low - pad)..(high + pad))
    else {
        return;
    };
    let _ = chart.configure_mesh().light_line_style(TRANSPARENT).draw();
    let points = || values.iter().enumerate().map(|(i, v)| (i as f64 + 0.5, *v));
    let _ = match kind {
        "Bar" => chart
            .draw_series(values.iter().enumerate().map(|(i, v)| {
                Rectangle::new([(i as f64 + 0.1, low.min(0.0)), (i as f64 + 0.9, *v)], color.filled())
            }))
            .map(|_| ()),
        "Points" => chart
            .draw_series(points().map(|p| Circle::new(p, 4, color.filled())))
            .map(|_| ()),
        "Area" => chart
            .draw_series(AreaSeries::new(points(), low.min(0.0), color.mix(0.3)).border_style(color))
            .map(|_| ()),
        _ => chart.draw_series(LineSeries::new(points(), &color)).map(|_| ()),
    };
    let _ = root.present();
}
