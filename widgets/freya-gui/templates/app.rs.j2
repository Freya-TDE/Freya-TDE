/// Registers form `name` for `show_<name>()` (called by `run()`).
pub fn freya_register_window(name: &'static str, window: Box<dyn Fn() -> WindowConfig>) {
    FREYA_WINDOWS.with(|w| w.borrow_mut().push((name, window)));
}

/// Opens form `name` in a window of its own.
#[allow(dead_code)]
pub fn freya_show(name: &str) {
    let config = FREYA_WINDOWS.with(|w| w.borrow().iter().find(|(n, _)| *n == name).map(|(_, f)| f()));
    if let Some(config) = config {
        spawn(async move {
            Platform::get().launch_window(config).await;
        });
    }
}
