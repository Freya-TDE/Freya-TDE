/// A CodeEditor: keeps freya's editor state itself; reports edits with
/// `on_change` and takes over a text the form set from outside.
pub struct CodeView {
    pub text: String,
    pub language: fn() -> Option<freya::code_editor::EditorLanguage>,
    pub read_only: bool,
    pub line_numbers: bool,
    pub font_family: &'static str,
    pub font_size: f32,
    pub on_change: EventHandler<String>,
}

// Die Sprache ist je Widget fest (Funktionszeiger vergleichen sich nicht sinnvoll).
impl PartialEq for CodeView {
    fn eq(&self, other: &Self) -> bool {
        self.text == other.text
            && self.read_only == other.read_only
            && self.line_numbers == other.line_numbers
            && self.font_family == other.font_family
            && self.font_size == other.font_size
            && self.on_change == other.on_change
    }
}

impl Component for CodeView {
    fn render(&self) -> impl IntoElement {
        use freya::code_editor::*;
        let a11y_id = use_a11y();
        let (font_family, font_size, language) = (self.font_family, self.font_size, self.language);
        let text = self.text.clone();
        let mut editor = use_state(move || {
            let mut editor = CodeEditorData::new(Rope::from_str(&text), language());
            editor.parse();
            editor.measure(font_size, font_family);
            editor
        });
        // Der zuletzt abgeglichene Text (Editor und Formular).
        let known = use_hook({
            let text = self.text.clone();
            move || std::rc::Rc::new(std::cell::RefCell::new(text))
        });
        if *known.borrow() != self.text {
            *known.borrow_mut() = self.text.clone();
            if editor.peek().to_string() != self.text {
                let mut data = editor.write();
                data.rope = Rope::from_str(&self.text);
                data.parse();
                data.measure(font_size, font_family);
            }
        }
        let on_change = self.on_change.clone();
        use_side_effect({
            let known = known.clone();
            move || {
                let text = editor.read().to_string();
                if *known.borrow() != text {
                    *known.borrow_mut() = text.clone();
                    on_change.call(text);
                }
            }
        });
        CodeEditor::new(editor, a11y_id)
            .read_only(self.read_only)
            .gutter(self.line_numbers)
            .font_family(self.font_family)
            .font_size(self.font_size)
    }
}
