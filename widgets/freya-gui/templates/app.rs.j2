/// Layout of a DockArea: panels and splits with tabs (index of the child).
pub struct FreyaDock {
    root: Option<DockNode<usize, u32>>,
    last_panel: u32,
}

impl DockingModel for FreyaDock {
    type TabId = usize;
    type PanelId = u32;
    type DropValue = usize;

    fn root(&self) -> Option<&DockNode<usize, u32>> {
        self.root.as_ref()
    }

    fn on_drop(&mut self, tab: usize, target: DropTarget<u32>) -> bool {
        let Some(root) = self.root.as_mut() else {
            return false;
        };
        match target {
            DropTarget::Tab { panel_id, position } => {
                root.remove_tab_except(&tab, Some(&panel_id));
                if let Some(panel) = root.panel_mut(&panel_id) {
                    panel.insert_tab(tab, position);
                }
            }
            DropTarget::Center(panel_id) => {
                root.remove_tab_except(&tab, Some(&panel_id));
                if let Some(panel) = root.panel_mut(&panel_id) {
                    panel.append_tab(tab);
                }
            }
            DropTarget::Split { panel_id, side } => {
                root.remove_tab_except(&tab, None);
                self.last_panel += 1;
                root.split_panel(&panel_id, side, &DockPanel::new(self.last_panel, vec![tab]));
            }
        }
        root.close_empty_panels();
        true
    }

    fn set_active(&mut self, panel_id: u32, tab_id: usize) -> bool {
        match self.root.as_mut().and_then(|root| root.panel_mut(&panel_id)) {
            Some(panel) => {
                panel.active_tab_id = Some(tab_id);
                true
            }
            None => false,
        }
    }
}

/// A DockArea: keeps its layout itself, shows the children as tabs.
#[derive(PartialEq)]
pub struct DockView {
    pub titles: Vec<String>,
    pub contents: Vec<Element>,
}

impl Component for DockView {
    fn render(&self) -> impl IntoElement {
        let count = self.titles.len();
        let dock = use_state(move || FreyaDock {
            root: Some(DockNode::Panel(DockPanel::new(0, (0..count).collect()))),
            last_panel: 0,
        });
        let contents = self.contents.clone();
        let tab_titles = self.titles.clone();
        let drag_titles = self.titles.clone();
        DockingArea::new(
            dock,
            move |context: ContentContext<usize, u32>| {
                context
                    .tab_id
                    .and_then(|tab| contents.get(tab).cloned())
                    .unwrap_or_else(|| rect().into_element())
            },
            move |context: TabContext<usize>| {
                rect()
                    .padding(Gaps::new(4.0, 10.0, 4.0, 10.0))
                    .maybe(context.is_drop_target, |el| el.background(color(0x3b, 0x82, 0xf6, 90)))
                    .child(tab_titles.get(context.tab_id).cloned().unwrap_or_default())
                    .into_element()
            },
            move |tab: usize| {
                rect()
                    .padding(Gaps::new(4.0, 10.0, 4.0, 10.0))
                    .background(color(0x3b, 0x82, 0xf6, 160))
                    .child(drag_titles.get(tab).cloned().unwrap_or_default())
                    .into_element()
            },
            |context: TabBarContext<u32>| {
                rect()
                    .horizontal()
                    .width(Size::fill())
                    .spacing(2.0)
                    .children(context.tab_children)
                    .into_element()
            },
        )
    }
}
