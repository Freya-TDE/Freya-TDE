{#- iced: the form as an Elm-style program (appended to <form>.gen.rs).
    Every input is a `Message`; `update` changes the state and calls the
    handlers in <form>.rs; `view` builds the UI, one method
    `freya_view_<name>` per container. -#}
{%- set containers = ["core/Form", "core/Container", "backend:iced/GroupBox", "backend:iced/Tabs"] %}
{#- Widgets that keep their natural width even with align Fill. -#}
{%- set natural = ["core/Label", "core/CheckBox", "backend:iced/RadioButton", "backend:iced/Toggler"] %}
{#- Wie die Theme-Tabelle des Designers (designer/themes/linux.toml): Rand 12, Abstand 8. -#}
{%- set default_layout = {"kind": "vertical", "spacing": 8, "padding": {"left": 12, "top": 12, "right": 12, "bottom": 12}} %}

{#- A colour property as `iced::Color`. -#}
{%- macro color(v) -%}
iced::Color::from_rgba8({{ v.r }}, {{ v.g }}, {{ v.b }}, {{ v.a }} as f32 / 255.0)
{%- endmacro %}

{#- Size and font of a text-bearing widget: own setting, else the form's.
    `size_method`: `size` or `text_size`. -#}
{%- macro text_style(c, size_method) -%}
{%- set rp = root.props -%}
{%- set size = c.props.font_size if c.props.font_size > 0 else rp.font_size -%}
{%- set bold = c.props.bold or rp.bold -%}
{%- set italic = c.props.italic or rp.italic -%}
{%- if size > 0 %}.{{ size_method }}({{ size }} as f32){% endif -%}
{%- if bold or italic %}.font(iced::Font { {% if bold %}weight: iced::font::Weight::Bold, {% endif %}{% if italic %}style: iced::font::Style::Italic, {% endif %}..Self::DEFAULT_FONT }){% endif -%}
{%- endmacro %}

{%- macro padding(p) -%}
iced::Padding { top: {{ p.top }} as f32, right: {{ p.right }} as f32, bottom: {{ p.bottom }} as f32, left: {{ p.left }} as f32 }
{%- endmacro %}

{#- The widget `c` as an expression that converts into an Element. -#}
{%- macro widget(c, fill) -%}
{%- set t = c.type -%}
{%- if t == "core/Label" -%}
iced::widget::text(self.{{ c.name }}.value.as_str()){{ text_style(c, "size") }}
{%- elif t == "core/Button" -%}
iced::widget::button(
    {%- if fill -%}
    iced::widget::text(self.{{ c.name }}.caption.as_str()){{ text_style(c, "size") }}.width(iced::Fill).align_x(iced::alignment::Horizontal::Center)
    {%- else -%}
    iced::widget::text(self.{{ c.name }}.caption.as_str()){{ text_style(c, "size") }}
    {%- endif -%}
).on_press_maybe(self.{{ c.name }}.enabled.then_some(Message::{{ c.name }}_click)){% if fill %}.width(iced::Fill){% endif %}
{%- if c.props.background.a > 0 or c.props.foreground.a > 0 -%}
.style(|theme: &iced::Theme, status| {
    let mut style = iced::widget::button::primary(theme, status);
    {%- if c.props.background.a > 0 %}
    style.background = Some(iced::Background::Color({{ color(c.props.background) }}));
    {%- endif %}
    {%- if c.props.foreground.a > 0 %}
    style.text_color = {{ color(c.props.foreground) }};
    {%- endif %}
    style
})
{%- endif -%}
{%- elif t == "core/Edit" -%}
iced::widget::text_input({{ c.rust.placeholder }}, self.{{ c.name }}.value.as_str())
    {%- if not c.props.read_only %}.on_input_maybe(self.{{ c.name }}.enabled.then_some(Message::{{ c.name }}_input)){% endif -%}
    .on_submit(Message::{{ c.name }}_submit)
    {%- if c.props.password %}.secure(true){% endif %}{{ text_style(c, "size") }}
{%- elif t == "core/CheckBox" -%}
iced::widget::checkbox(self.{{ c.name }}.value).label(self.{{ c.name }}.caption.as_str()){{ text_style(c, "text_size") }}.on_toggle_maybe(self.{{ c.name }}.enabled.then_some(Message::{{ c.name }}_toggle))
{%- elif t == "backend:iced/RadioButton" -%}
iced::widget::radio(self.{{ c.name }}.caption.as_str(), true, self.{{ c.name }}.value.then_some(true), |_| Message::{{ c.name }}_select){{ text_style(c, "text_size") }}
{%- elif t == "backend:iced/Toggler" -%}
iced::widget::toggler(self.{{ c.name }}.value).label(self.{{ c.name }}.caption.as_str()){{ text_style(c, "text_size") }}.on_toggle_maybe(self.{{ c.name }}.enabled.then_some(Message::{{ c.name }}_toggle))
{%- elif t == "backend:iced/Slider" -%}
iced::widget::row(vec![
    iced::widget::slider({{ c.rust.minimum }}..={{ c.rust.maximum }}, self.{{ c.name }}.value, Message::{{ c.name }}_change).step({{ c.rust.step }}).into(),
    {%- if c.props.show_value %}
    iced::widget::text(format!("{}", self.{{ c.name }}.value)).into(),
    {%- endif %}
]).spacing(8).align_y(iced::alignment::Vertical::Center)
{%- elif t == "backend:iced/ProgressBar" -%}
{
    let mut parts: Vec<iced::Element<'_, Message>> = Vec::new();
    if !self.{{ c.name }}.caption.is_empty() {
        parts.push(iced::widget::text(self.{{ c.name }}.caption.as_str()).size(12).into());
    }
    parts.push(iced::widget::progress_bar(0.0..=1.0, self.{{ c.name }}.value).into());
    iced::widget::column(parts).spacing(2)
}
{%- elif t == "backend:iced/PickList" -%}
iced::widget::pick_list(self.{{ c.name }}.items.as_slice(), self.{{ c.name }}.items.get(self.{{ c.name }}.value), Message::{{ c.name }}_select){% if fill %}.width(iced::Fill){% endif %}
{%- elif t == "backend:iced/ListBox" -%}
{
    let rows: Vec<iced::Element<'_, Message>> = self
        .{{ c.name }}
        .items
        .iter()
        .enumerate()
        .map(|(index, item)| {
            let style: fn(&iced::Theme, iced::widget::button::Status) -> iced::widget::button::Style =
                if self.{{ c.name }}.value == index as i32 {
                    iced::widget::button::primary
                } else {
                    iced::widget::button::text
                };
            iced::widget::button(iced::widget::text(item.as_str()))
                .width(iced::Fill)
                .style(style)
                .on_press_maybe(self.{{ c.name }}.enabled.then_some(Message::{{ c.name }}_select(index)))
                .into()
        })
        .collect();
    iced::widget::container(iced::widget::scrollable(iced::widget::column(rows)).height(120))
        .style(iced::widget::container::bordered_box)
        .padding(2)
}
{%- elif t == "backend:iced/DataGrid" -%}
{
    let selected = self.{{ c.name }}.value.selected;
    let enabled = self.{{ c.name }}.enabled;
    let columns: Vec<_> = self
        .{{ c.name }}
        .value
        .headers
        .iter()
        .enumerate()
        .map(|(column, header)| {
            iced::widget::table::column(
                iced::widget::text(header.as_str()),
                move |(index, row): (usize, &Vec<String>)| {
                    let style: fn(&iced::Theme, iced::widget::button::Status) -> iced::widget::button::Style =
                        if selected == Some(index) {
                            iced::widget::button::primary
                        } else {
                            iced::widget::button::text
                        };
                    iced::widget::button(iced::widget::text(row.get(column).map(String::as_str).unwrap_or("")))
                        .style(style)
                        .padding(2)
                        .on_press_maybe(enabled.then_some(Message::{{ c.name }}_select(index)))
                },
            )
        })
        .collect();
    // Ohne Spalten (vor dem ersten Laden) kein `table`: es teilt durch die Spaltenzahl.
    let content: iced::Element<'_, Message> = if columns.is_empty() {
        iced::widget::space().into()
    } else {
        iced::widget::table(columns, self.{{ c.name }}.value.rows.iter().enumerate()).into()
    };
    iced::widget::container(iced::widget::scrollable(content).height(160))
    .style(iced::widget::container::bordered_box)
    .width(iced::Fill)
}
{%- elif t == "backend:iced/TextEditor" -%}
iced::widget::text_editor(&self.{{ c.name }}.value)
    {%- if not c.props.read_only %}.on_action(Message::{{ c.name }}_edit){% endif -%}
    .height({{ c.props.rows * 24 }})
{%- elif t == "backend:iced/Rule" -%}
iced::widget::rule::{{ "vertical" if c.props.vertical else "horizontal" }}(1)
{%- else -%}
iced::widget::text("{{ c.type_name }}")
{%- endif -%}
{%- endmacro %}

{#- The child `c` as an Element (container: its own view method). -#}
{%- macro child(c, fill) -%}
{%- set coloured = c.type != "core/Button" and (c.props.background.a > 0 or c.props.foreground.a > 0) -%}
{%- if c.type in containers -%}
self.{{ c.name }}.show(self.freya_view_{{ c.name }}())
{%- elif coloured -%}
self.{{ c.name }}.show(
    iced::widget::container({{ widget(c, fill) }})
        .style(|_| iced::widget::container::Style {
            {%- if c.props.background.a > 0 %}
            background: Some(iced::Background::Color({{ color(c.props.background) }})),
            {%- endif %}
            {%- if c.props.foreground.a > 0 %}
            text_color: Some({{ color(c.props.foreground) }}),
            {%- endif %}
            ..Default::default()
        })
        .into(),
)
{%- else -%}
self.{{ c.name }}.show({{ widget(c, fill) }}.into())
{%- endif -%}
{%- endmacro %}

{%- if root %}
#[allow(unused_imports)]
use iced::widget::text_editor;

/// Everything the user can do in form `{{ form.name }}`.
#[allow(non_camel_case_types, dead_code)]
#[derive(Debug, Clone)]
pub enum Message {
{%- for c in widgets if c.field %}
{%- set t = c.type %}
{%- if t == "core/Button" %}
    {{ c.name }}_click,
{%- elif t == "core/Edit" %}
    {{ c.name }}_input(String),
    {{ c.name }}_submit,
{%- elif t in ["core/CheckBox", "backend:iced/Toggler"] %}
    {{ c.name }}_toggle(bool),
{%- elif t == "backend:iced/RadioButton" %}
    {{ c.name }}_select,
{%- elif t == "backend:iced/Slider" %}
    {{ c.name }}_change(f64),
{%- elif t == "backend:iced/PickList" %}
    {{ c.name }}_select(String),
{%- elif t in ["backend:iced/ListBox", "backend:iced/DataGrid"] %}
    {{ c.name }}_select(usize),
{%- elif t == "backend:iced/TextEditor" %}
    {{ c.name }}_edit(text_editor::Action),
{%- elif t == "backend:iced/Tabs" %}
    {{ c.name }}_page(usize),
{%- endif %}
{%- endfor %}
{%- if root.events.on_close %}
    close_requested(iced::window::Id),
{%- endif %}
{%- if data_bound %}
    /// Rows of a list arrived (data binding).
    freya_data,
{%- endif %}
}

impl {{ form.struct }} {
    /// Window settings from the designer (size, resizable).
    pub fn window_settings() -> iced::window::Settings {
        iced::window::Settings {
            size: iced::Size::new({{ root.props.size.width }} as f32, {{ root.props.size.height }} as f32),
            resizable: {{ root.rust.resizable }},
        {%- set rp = root.props %}
        {%- if rp.min_size.width > 0 or rp.min_size.height > 0 %}
            min_size: Some(iced::Size::new({{ rp.min_size.width }} as f32, {{ rp.min_size.height }} as f32)),
        {%- endif %}
        {%- if rp.max_size.width > 0 or rp.max_size.height > 0 %}
            max_size: Some(iced::Size::new({{ rp.max_size.width if rp.max_size.width > 0 else 100000 }} as f32, {{ rp.max_size.height if rp.max_size.height > 0 else 100000 }} as f32)),
        {%- endif %}
            position: {% if rp.position == "Center" %}iced::window::Position::Centered{% elif rp.position == "Manual" %}iced::window::Position::Specific(iced::Point::new({{ rp.location.x }} as f32, {{ rp.location.y }} as f32)){% else %}iced::window::Position::Default{% endif %},
            maximized: {{ "true" if rp.start_state == "Maximized" else "false" }},
            fullscreen: {{ "true" if rp.start_state == "Fullscreen" else "false" }},
            ..Default::default()
        }
    }

    /// Font of the form (family from the designer).
    pub const DEFAULT_FONT: iced::Font = {% if root.props.font_family %}iced::Font {
        family: iced::font::Family::Name({{ root.rust.font_family }}),
        ..iced::Font::DEFAULT
    }{% else %}iced::Font::DEFAULT{% endif %};

    /// Light or dark look (`None` = as the system).
    pub fn theme(&self) -> Option<iced::Theme> {
    {%- if root.props.theme == "Dark" %}
        Some(iced::Theme::Dark)
    {%- elif root.props.theme == "Light" %}
        Some(iced::Theme::Light)
    {%- else %}
        None
    {%- endif %}
    }

    /// Closing the window ends the program unless `on_close` decides.
    pub const EXIT_ON_CLOSE: bool = {{ "false" if root.events.on_close else "true" }};

    /// The window title (the caption of `{{ root.name }}`).
    pub fn title(&self) -> String {
        self.{{ root.name }}.caption.clone()
    }

    /// Called once before the window opens.
    pub fn freya_created(&mut self) {
        // Daten der Listen laden (im Hintergrund).
        self.freya_start_data();
    {%- if root.events.on_create %}
        self.{{ root.events.on_create }}();
    {%- endif %}
    }

    /// Events from outside the widgets (closing the window).
    pub fn subscription(&self) -> iced::Subscription<Message> {
        iced::Subscription::batch([
        {%- if root.events.on_close %}
            iced::window::close_requests().map(Message::close_requested),
        {%- endif %}
        {%- if data_bound %}
            iced::Subscription::run(freya_data_events),
        {%- endif %}
            iced::Subscription::none(),
        ])
    }

    /// Applies `message` to the state and calls the handler.
    #[allow(unused_variables, clippy::needless_return)]
    pub fn update(&mut self, message: Message) -> iced::Task<Message> {
        match message {
        {%- if data_bound %}
            Message::freya_data => {
                self.freya_take_data();
            }
        {%- endif %}
        {%- for c in widgets if c.field %}
        {%- set t = c.type %}
        {%- set e = c.events %}
        {%- if t == "core/Button" %}
            Message::{{ c.name }}_click => {
            {%- if e.on_click %}
                if self.{{ c.name }}.enabled {
                    self.{{ e.on_click }}();
                }
            {%- endif %}
            }
        {%- elif t == "core/Edit" %}
            Message::{{ c.name }}_input(text) => {
            {%- if c.props.max_length > 0 %}
                self.{{ c.name }}.value = text.chars().take({{ c.props.max_length }}).collect();
            {%- else %}
                self.{{ c.name }}.value = text;
            {%- endif %}
            {%- if e.on_change %}
                let text = self.{{ c.name }}.value.clone();
                self.{{ e.on_change }}(&text);
            {%- endif %}
            }
            Message::{{ c.name }}_submit => {
            {%- if e.on_submit %}
                self.{{ e.on_submit }}();
            {%- endif %}
            }
        {%- elif t in ["core/CheckBox", "backend:iced/Toggler"] %}
            Message::{{ c.name }}_toggle(checked) => {
                self.{{ c.name }}.value = checked;
            {%- if e.on_toggle %}
                self.{{ e.on_toggle }}(checked);
            {%- endif %}
            }
        {%- elif t == "backend:iced/Slider" %}
            Message::{{ c.name }}_change(value) => {
                if self.{{ c.name }}.enabled {
                    self.{{ c.name }}.value = value;
                {%- if e.on_change %}
                    self.{{ e.on_change }}(value);
                {%- endif %}
                }
            }
        {%- elif t == "backend:iced/PickList" %}
            Message::{{ c.name }}_select(item) => {
                if self.{{ c.name }}.enabled
                    && let Some(index) = self.{{ c.name }}.items.iter().position(|i| *i == item)
                {
                    self.{{ c.name }}.value = index;
                {%- if e.on_select %}
                    self.{{ e.on_select }}(index as u32);
                {%- endif %}
                }
            }
        {%- elif t == "backend:iced/ListBox" %}
            Message::{{ c.name }}_select(index) => {
                self.{{ c.name }}.value = index as i32;
            {%- if e.on_select %}
                self.{{ e.on_select }}(index as i32);
            {%- endif %}
            }
        {%- elif t == "backend:iced/DataGrid" %}
            Message::{{ c.name }}_select(index) => {
                self.{{ c.name }}.value.selected = Some(index);
            {%- if e.on_select %}
                self.{{ e.on_select }}(index as i32);
            {%- endif %}
            }
        {%- elif t == "backend:iced/TextEditor" %}
            Message::{{ c.name }}_edit(action) => {
                let edit = action.is_edit();
                if self.{{ c.name }}.enabled || !edit {
                    self.{{ c.name }}.value.perform(action);
                {%- if e.on_change %}
                    if edit {
                        let text = self.{{ c.name }}.value.text();
                        self.{{ e.on_change }}(&text);
                    }
                {%- endif %}
                }
            }
        {%- elif t == "backend:iced/Tabs" %}
            Message::{{ c.name }}_page(page) => {
                self.{{ c.name }}.value = page;
            {%- if e.on_page %}
                self.{{ e.on_page }}(page as u32);
            {%- endif %}
            }
        {%- endif %}
        {%- endfor %}
        {#- Optionsfelder: das gewählte an, die übrigen im selben Container aus. #}
        {%- for w in widgets if w.field and w.type in containers %}
        {%- set radios = w.children | selectattr("type", "eq", "backend:iced/RadioButton") | selectattr("field") | list %}
        {%- for c in radios %}
            Message::{{ c.name }}_select => {
                if self.{{ c.name }}.enabled {
                    self.{{ c.name }}.value = true;
                {%- for o in radios if o.name != c.name %}
                    self.{{ o.name }}.value = false;
                {%- endfor %}
                {%- if c.events.on_toggle %}
                    self.{{ c.events.on_toggle }}(true);
                {%- endif %}
                }
            }
        {%- endfor %}
        {%- endfor %}
        {%- if root.events.on_close %}
            Message::close_requested(_window) => {
                if self.{{ root.events.on_close }}() {
                    return iced::exit();
                }
            }
        {%- endif %}
        }
        iced::Task::none()
    }

    /// Builds the window's content from the state.
    pub fn view(&self) -> iced::Element<'_, Message> {
        {%- set rp = root.props %}
        let content = self.freya_view_{{ root.name }}();
        {%- if rp.background_image %}
        // Hintergrundbild hinter dem Inhalt.
        let content: iced::Element<'_, Message> = iced::widget::stack(vec![
            iced::widget::image(std::env::current_dir().unwrap_or_default().join({{ root.rust.background_image }}))
                .width(iced::Fill)
                .height(iced::Fill)
                .content_fit(iced::ContentFit::{{ {"Cover": "Cover", "Stretch": "Fill", "Contain": "Contain", "Center": "None"}[rp.background_fit] }})
                .into(),
            content,
        ])
        .into();
        {%- endif %}
        iced::widget::container(content)
            .width(iced::Fill)
            .height(iced::Fill)
        {%- if rp.background.a > 0 or rp.foreground.a > 0 %}
            .style(|_| iced::widget::container::Style {
            {%- if rp.background.a > 0 %}
                background: Some(iced::Background::Color({{ color(rp.background) }})),
            {%- endif %}
            {%- if rp.foreground.a > 0 %}
                text_color: Some({{ color(rp.foreground) }}),
            {%- endif %}
                ..Default::default()
            })
        {%- endif %}
            .into()
    }
{%- for w in widgets if w.field and w.type in containers %}
{%- set kids = w.children | selectattr("field") | list %}

    /// The children of `{{ w.name }}`.
    #[allow(unused_mut, clippy::vec_init_then_push)]
    fn freya_view_{{ w.name }}(&self) -> iced::Element<'_, Message> {
    {%- if w.type == "backend:iced/Tabs" %}
        // Reiterleiste, darunter nur die gewählte Seite.
        let mut header: Vec<iced::Element<'_, Message>> = Vec::new();
        {%- for c in kids %}
        {
            let title = self.{{ w.name }}.items.get({{ loop.index0 }}).cloned().unwrap_or_else(|| "{{ c.name }}".to_owned());
            let style: fn(&iced::Theme, iced::widget::button::Status) -> iced::widget::button::Style =
                if self.{{ w.name }}.value == {{ loop.index0 }} {
                    iced::widget::button::primary
                } else {
                    iced::widget::button::text
                };
            header.push(
                iced::widget::button(iced::widget::text(title))
                    .style(style)
                    .on_press(Message::{{ w.name }}_page({{ loop.index0 }}))
                    .into(),
            );
        }
        {%- endfor %}
        let page: iced::Element<'_, Message> = match self.{{ w.name }}.value {
        {%- for c in kids %}
            {{ loop.index0 }} => {{ child(c, true) }},
        {%- endfor %}
            _ => iced::widget::space().into(),
        };
        iced::widget::column(vec![
            iced::widget::row(header).spacing(4).into(),
            iced::widget::rule::horizontal(1).into(),
            page,
        ])
        .spacing(6)
        .into()
    {%- else %}
    {%- set l = w.layout or default_layout %}
        let mut children: Vec<iced::Element<'_, Message>> = Vec::new();
    {%- if l.kind == "grid" %}
        {%- set columns = l.columns or 1 %}
        {%- for row in kids | batch(columns) %}
        children.push(
            iced::widget::row(vec![
            {%- for c in row %}
            {%- set p = c.placement %}
            {%- if p and p.kind == "layout" and (p.width > 0 or p.height > 0) %}
                // Wunschgröße aus dem Designer.
                iced::widget::container(
                    iced::widget::container({{ child(c, true) }})
                        .width({% if p.width > 0 %}iced::Length::Fixed({{ p.width }} as f32){% else %}iced::Fill{% endif %})
                        .height({% if p.height > 0 %}iced::Length::Fixed({{ p.height }} as f32){% else %}iced::Shrink{% endif %}),
                )
                .width(iced::Fill)
                .into(),
            {%- else %}
                iced::widget::container({{ child(c, true) }}).width(iced::Fill).into(),
            {%- endif %}
            {%- endfor %}
            ])
            .spacing({{ l.spacing }})
            .into(),
        );
        {%- endfor %}
    {%- else %}
    {%- for c in kids if l.kind != "stack" or loop.first %}
        {%- set p = c.placement %}
        {%- set align = p.align if p and p.kind == "layout" else "Fill" %}
        {%- set stretch = p and p.kind == "layout" and p.stretch > 0 %}
        {%- set fill = l.kind in ["vertical", "custom"] and align == "Fill" and c.type not in natural %}
        {%- set sized = p and p.kind == "layout" and (p.width > 0 or p.height > 0) %}
        {#- Wunschgröße aus dem Designer: fester Rahmen, das Widget füllt ihn. #}
        {%- macro own(f) -%}
        {%- if sized -%}
        iced::widget::container({{ child(c, true) }}).width({% if p.width > 0 %}iced::Length::Fixed({{ p.width }} as f32){% elif f %}iced::Fill{% else %}iced::Shrink{% endif %}).height({% if p.height > 0 %}iced::Length::Fixed({{ p.height }} as f32){% else %}iced::Shrink{% endif %})
        {%- else -%}
        {{ child(c, f) }}
        {%- endif -%}
        {%- endmacro %}
        {%- set wp = p.width_percent if p and p.kind == "layout" else 0 %}
        {%- set hp = p.height_percent if p and p.kind == "layout" else 0 %}
        {%- if l.kind == "absolute" and p and p.kind == "absolute" %}
        {%- set a = p.anchors %}
        {#- Anker: Ausrichtung und Innenabstand in einer Ebene des Stapels
            (links und rechts = wächst mit, nur rechts = wandert mit, keins = mittig). #}
        {%- set cx = p.x + p.width / 2 - p.area.width / 2 %}
        {%- set cy = p.y + p.height / 2 - p.area.height / 2 %}
        children.push(
            iced::widget::container(
                iced::widget::container({{ child(c, true) }})
                    .width({% if a.left and a.right %}iced::Fill{% else %}iced::Length::Fixed({{ p.width }} as f32){% endif %})
                    .height({% if a.top and a.bottom %}iced::Fill{% else %}iced::Length::Fixed({{ p.height }} as f32){% endif %}),
            )
            .width(iced::Fill)
            .height({% if a.bottom or not a.top %}iced::Fill{% else %}iced::Shrink{% endif %})
            .align_x(iced::alignment::Horizontal::{% if a.left %}Left{% elif a.right %}Right{% else %}Center{% endif %})
            .align_y(iced::alignment::Vertical::{% if a.top %}Top{% elif a.bottom %}Bottom{% else %}Center{% endif %})
            .padding(iced::Padding {
                top: {% if a.top %}{{ p.y }}{% elif a.bottom %}0{% else %}{{ [2 * cy, 0] | max }}{% endif %} as f32,
                right: {% if a.right %}{{ p.margin_right }}{% elif a.left %}0{% else %}{{ [-2 * cx, 0] | max }}{% endif %} as f32,
                bottom: {% if a.bottom %}{{ p.margin_bottom }}{% elif a.top %}0{% else %}{{ [-2 * cy, 0] | max }}{% endif %} as f32,
                left: {% if a.left %}{{ p.x }}{% elif a.right %}0{% else %}{{ [2 * cx, 0] | max }}{% endif %} as f32,
            })
            .into(),
        );
        {%- elif (wp > 0 or hp > 0) and l.kind in ["vertical", "custom", "horizontal"] %}
        {%- set row_layout = l.kind == "horizontal" %}
        {%- set cross = hp if row_layout else wp %}
        {%- set main = wp if row_layout else hp %}
        {#- Prozent: quer zum Layout ein Anteil der Breite bzw. Höhe (FillPortion
            neben einem Leerraum), in Layout-Richtung ein Anteil am freien Platz. #}
        {%- set inner = "iced::widget::container(" ~ child(c, true) ~ ")" %}
        {%- if cross > 0 and cross < 100 %}
        {%- if row_layout %}
        {%- set inner = "iced::widget::column(vec![iced::widget::container(" ~ child(c, true) ~ ").height(iced::FillPortion(" ~ cross ~ ")).into(), iced::widget::space().height(iced::FillPortion(" ~ (100 - cross) ~ ")).into()])" %}
        {%- else %}
        {%- set inner = "iced::widget::row(vec![iced::widget::container(" ~ child(c, true) ~ ").width(iced::FillPortion(" ~ cross ~ ")).into(), iced::widget::space().width(iced::FillPortion(" ~ (100 - cross) ~ ")).into()])" %}
        {%- endif %}
        {%- endif %}
        children.push(
            iced::widget::container({{ inner }})
                .width({% if row_layout and main > 0 %}iced::FillPortion({{ main }}){% elif not row_layout %}iced::Fill{% else %}iced::Shrink{% endif %})
                .height({% if not row_layout and main > 0 %}iced::FillPortion({{ main }}){% elif row_layout %}iced::Fill{% else %}iced::Shrink{% endif %})
                .into(),
        );
        {%- elif l.kind in ["vertical", "custom"] and align in ["Center", "End"] %}
        children.push(
            iced::widget::container({{ own(false) }})
                .width(iced::Fill)
                .align_x(iced::alignment::Horizontal::{{ "Center" if align == "Center" else "Right" }})
                .into(),
        );
        {%- elif stretch %}
        children.push(
            iced::widget::container({{ own(fill) }})
                {%- if l.kind == "horizontal" %}
                .width(iced::Fill)
                {%- else %}
                .height(iced::Fill)
                {%- endif %}
                .into(),
        );
        {%- elif sized %}
        children.push({{ own(fill) }}.into());
        {%- else %}
        children.push({{ child(c, fill) }});
        {%- endif %}
    {%- endfor %}
    {%- set total = namespace(main=0) %}
    {%- for c in kids if c.placement and c.placement.kind == "layout" %}
    {%- set total.main = total.main + (c.placement.width_percent if l.kind == "horizontal" else c.placement.height_percent) %}
    {%- endfor %}
    {%- if l.kind in ["vertical", "custom", "horizontal"] and total.main > 0 and total.main < 100 %}
        // Rest des Platzes neben den Größen in Prozent.
        children.push(iced::widget::space().{{ "width" if l.kind == "horizontal" else "height" }}(iced::FillPortion({{ 100 - total.main }})).into());
    {%- endif %}
    {%- endif %}
    {%- if l.kind == "horizontal" %}
        let inner: iced::Element<'_, Message> = iced::widget::row(children)
            .spacing({{ l.spacing }})
            .padding({{ padding(l.padding) }})
            .align_y(iced::alignment::Vertical::Center)
            .into();
    {%- elif l.kind == "absolute" %}
        {%- set ext = namespace(w=0, h=0, grow_x=false, grow_y=false) %}
        {%- for c in kids if c.placement and c.placement.kind == "absolute" %}
        {%- set ext.w = [ext.w, c.placement.x + c.placement.width] | max %}
        {%- set ext.h = [ext.h, c.placement.y + c.placement.height] | max %}
        {%- if c.placement.anchors.right or not c.placement.anchors.left %}{% set ext.grow_x = true %}{% endif %}
        {%- if c.placement.anchors.bottom or not c.placement.anchors.top %}{% set ext.grow_y = true %}{% endif %}
        {%- endfor %}
        // Unterste Ebene: die Ausdehnung der Kinder (Mindestgröße).
        children.insert(0, iced::widget::space().width({{ ext.w }}).height({{ ext.h }}).into());
        let inner: iced::Element<'_, Message> = iced::widget::container(
            iced::widget::stack(children)
                .width({% if ext.grow_x %}iced::Fill{% else %}iced::Shrink{% endif %})
                .height({% if ext.grow_y %}iced::Fill{% else %}iced::Shrink{% endif %}),
        )
        .padding({{ padding(l.padding) }})
        .into();
    {%- else %}
        let inner: iced::Element<'_, Message> = iced::widget::column(children)
            .spacing({{ l.spacing }})
            .padding({{ padding(l.padding) }})
            .width(iced::Fill)
            .into();
    {%- endif %}
    {%- if w.type == "backend:iced/GroupBox" %}
        iced::widget::column(vec![
            iced::widget::text(self.{{ w.name }}.caption.as_str()).size(14).into(),
            iced::widget::container(inner)
                .width(iced::Fill)
                .style(iced::widget::container::bordered_box)
                .into(),
        ])
        .spacing(4)
        .into()
    {%- else %}
        inner
    {%- endif %}
    {%- endif %}
    }
{%- endfor %}
}
{%- if data_bound %}

/// Wakes the program when rows of a list arrived (data binding).
fn freya_data_events() -> impl iced::futures::Stream<Item = Message> {
    use iced::futures::StreamExt as _;
    let (sender, receiver) = iced::futures::channel::mpsc::unbounded::<()>();
    // Einmal sofort: schon fertige Ladevorgänge übernehmen.
    let _ = sender.unbounded_send(());
    crate::app::freya_set_waker(move || {
        let _ = sender.unbounded_send(());
    });
    receiver.map(|()| Message::freya_data)
}
{%- endif %}
{%- endif %}
